; port until an ack bit (0-1) is set.

; ---- sdc_write_reg ---- called from 114, 11C, 12F, 135, 15E, 167, 16C, 170, 176, 181, 190
sdc_write_reg:
    OUTPUT sD, (sE)                 ; 1AF 2DDE0
    JUMP sdc_wait_ack               ; 1B0 341B1

