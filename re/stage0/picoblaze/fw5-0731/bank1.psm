    LOAD s1, s1                     ; 24A 01110
    LOAD s1, s1                     ; 24B 01110
    INPUT s3, TBL_Q3                ; 24C 043C0
    INPUT s2, TBL_Q2                ; 24D 042C1
    INPUT s1, TBL_Q1                ; 24E 041C2
    INPUT s0, TBL_Q0                ; 24F 040C3
    RETURN                          ; 250 2A000

; Find the extent holding file offset sA:s9:s8:s7 (linear scan,
