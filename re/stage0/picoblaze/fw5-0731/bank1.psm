; ---- i2c_clock_pulse ---- called from 2A7
i2c_clock_pulse:
    CALL i2c_delay3                 ; 2B1 302D5
    CALL i2c_scl_high_wait          ; 2B2 302BF
    CALL i2c_delay2                 ; 2B3 302D6
    CALL i2c_scl_low                ; 2B4 302BB
    RETURN                          ; 2B5 2A000

; ---- i2c_nack ---- called from 306
i2c_nack:
