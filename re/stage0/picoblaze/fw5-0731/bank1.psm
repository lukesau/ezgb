; Switch to bank 2 (X3Y25) and back. The instruction after each
; OUTPUT is fetched before the switch lands, hence the no-ops;
; $3F3 in bank 2 is CALL $1B5.

; ---- call_bank2 ---- called from 003, 369
call_bank2:
    LOAD s0, 01                     ; 3F0 00001
    OUTPUT s0, BANK_SELECT          ; 3F1 2C0C8
    LOAD s0, s0                     ; 3F2 01000
    LOAD s0, s0                     ; 3F3 01000  bank 2 executes CALL $1B5 here
    LOAD s0, 00                     ; 3F4 00000
    OUTPUT s0, BANK_SELECT          ; 3F5 2C0C8
    LOAD s0, s0                     ; 3F6 01000
    RETURN                          ; 3F7 2A000
