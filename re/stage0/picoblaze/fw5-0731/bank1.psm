L_2A7:
    CALL i2c_clock_pulse            ; 2A7 302B1
    SR0 s1                          ; 2A8 2010E
    RETURN C                        ; 2A9 2B800
    JUMP L_2A2                      ; 2AA 342A2

; ---- i2c_read_byte ---- called from 304, 30A
i2c_read_byte:
