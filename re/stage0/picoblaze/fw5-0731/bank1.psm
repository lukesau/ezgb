; RTC init. If the seconds register's VL bit says the clock lost
; power, stop it and load a default date.

; ---- rtc_init ---- called from 02E
rtc_init:
    LOAD sB, 00                     ; 31B 00B00
    CALL rtc_write_zero             ; 31C 302DF
    LOAD sB, 02                     ; 31D 00B02
    CALL rtc_read                   ; 31E 30303  seconds, bit 7 = VL (clock integrity lost)
    AND sD, 80                      ; 31F 0AD80
    COMPARE sD, 80                  ; 320 14D80
    RETURN NZ                       ; 321 2B400
    LOAD sB, 00                     ; 322 00B00
    LOAD sD, 20                     ; 323 00D20
    CALL rtc_write                  ; 324 302E0
    LOAD sB, 08                     ; 325 00B08  years 0
    CALL rtc_write_zero             ; 326 302DF
    LOAD sB, 07                     ; 327 00B07
    LOAD sD, 01                     ; 328 00D01  month 1
    CALL rtc_write                  ; 329 302E0
    LOAD sB, 06                     ; 32A 00B06
    LOAD sD, 03                     ; 32B 00D03  weekday 3
    CALL rtc_write                  ; 32C 302E0
    LOAD sB, 05                     ; 32D 00B05
    LOAD sD, 01                     ; 32E 00D01  day 1
    CALL rtc_write                  ; 32F 302E0
    LOAD sB, 04                     ; 330 00B04
    CALL rtc_write_zero             ; 331 302DF
    LOAD sB, 03                     ; 332 00B03
    CALL rtc_write_zero             ; 333 302DF
    LOAD sB, 02                     ; 334 00B02
    CALL rtc_write_zero             ; 335 302DF
    LOAD sB, 01                     ; 336 00B01
    CALL rtc_write_zero             ; 337 302DF
    LOAD sB, 00                     ; 338 00B00
    CALL rtc_write_zero             ; 339 302DF
    RETURN                          ; 33A 2A000

