L_2C1:
    INPUT s0, I2C_IN                ; 2C1 040EB
    TEST s0, 01                     ; 2C2 12001
    JUMP Z, L_2C1                   ; 2C3 352C1
    RETURN                          ; 2C4 2A000

; ---- i2c_sda_low ---- called from 297, 29B, 2A4, 2B0
i2c_sda_low:
