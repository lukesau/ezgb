; Read one 32-bit table entry: index s5 -> s3:s2:s1:s0.

; ---- tbl_read ---- called from 1FD, 203, 234, 253, 265, 26C
tbl_read:
    OUTPUT s5, TBL_INDEX            ; 248 2C5BF
