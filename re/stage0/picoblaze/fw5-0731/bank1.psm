    JUMP i2c_clock_pulse            ; 2B7 342B1

; ---- i2c_read_ack ---- called from 2E5, 2E9, 2ED, 2F6, 2FA, 300
i2c_read_ack:
    CALL i2c_read_bit               ; 2B8 302CB
    TEST s5, 01                     ; 2B9 12501
    RETURN                          ; 2BA 2A000

; ---- i2c_scl_low ---- called from 299, 2B4, 2D3
i2c_scl_low:
    AND sF, 02                      ; 2BB 0AF02
