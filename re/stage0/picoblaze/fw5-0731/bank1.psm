; ---- sdc_zero_upper ---- called from 10B, 119, 125, 12C, 133, 169
sdc_zero_upper:
    LOAD sD, 00                     ; 137 00D00
    OUTPUT sD, SDC_D3               ; 138 2CD73
    OUTPUT sD, SDC_D2               ; 139 2CD72
    OUTPUT sD, SDC_D1               ; 13A 2CD71
    RETURN                          ; 13B 2A000

; Send an SD command through the controller.
; sC = command index, sB = response flags (b0 response, b1 136-bit,
; b2 CRC check, b3 busy, b4 index check), sA:s9:s8:s7 = argument,
; xfer_dir = 0 none / 1 read / 2 write. Waits for completion.

; ---- sd_command ---- called from 0DF, 0FA, 1EC
sd_command:
    LOAD s0, 00                     ; 13C 00000
    TEST sB, 01                     ; 13D 12B01
    JUMP Z, L_144                   ; 13E 35144
    TEST sB, 02                     ; 13F 12B02
    JUMP Z, L_143                   ; 140 35143
    OR s0, 02                       ; 141 0C002
    JUMP L_144                      ; 142 34144
L_143:
    OR s0, 01                       ; 143 0C001
L_144:
    TEST sB, 08                     ; 144 12B08
    JUMP Z, L_147                   ; 145 35147
    OR s0, 04                       ; 146 0C004
L_147:
    TEST sB, 04                     ; 147 12B04
    JUMP Z, L_14A                   ; 148 3514A
    OR s0, 08                       ; 149 0C008
L_14A:
    TEST sB, 10                     ; 14A 12B10
