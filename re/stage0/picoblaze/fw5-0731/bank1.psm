    LOAD s4, s8                     ; 256 01480
    SUBCY s4, s1                    ; 257 1F410
    LOAD s4, s9                     ; 258 01490
    SUBCY s4, s2                    ; 259 1F420
    LOAD s4, sA                     ; 25A 014A0
    SUBCY s4, s3                    ; 25B 1F430
    JUMP C, L_261                   ; 25C 35A61
    COMPARE s6, 7C                  ; 25D 1467C
    JUMP Z, L_263                   ; 25E 35263
    ADD s6, 02                      ; 25F 18602
    JUMP L_252                      ; 260 34252
L_261:
    SUB s6, 02                      ; 261 1C602
    JUMP L_264                      ; 262 34264
L_263:
    LOAD s6, 00                     ; 263 00600
L_264:
    CALL tbl_index                  ; 264 3023E
    CALL tbl_read                   ; 265 30248
    SUB s7, s0                      ; 266 1D700
    SUBCY s8, s1                    ; 267 1F810
    SUBCY s9, s2                    ; 268 1F920
    SUBCY sA, s3                    ; 269 1FA30
    ADD s6, 01                      ; 26A 18601
    CALL tbl_index                  ; 26B 3023E
    CALL tbl_read                   ; 26C 30248
    ADD s7, s0                      ; 26D 19700
    ADDCY s8, s1                    ; 26E 1B810
    ADDCY s9, s2                    ; 26F 1B920
    ADDCY sA, s3                    ; 270 1BA30
    CALL sector_to_card_addr        ; 271 30273
    RETURN                          ; 272 2A000

; SDSC cards are byte-addressed: shift the sector number left 9.

; ---- sector_to_card_addr ---- called from 271, 282
sector_to_card_addr:
    FETCH s4, sd_is_sdhc            ; 273 06406
