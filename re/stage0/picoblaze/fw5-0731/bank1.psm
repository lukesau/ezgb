; D0X19Y25.BEL.BRAM
; KCPSM3 (PicoBlaze for Spartan-3), 1K x 18
; 854 reachable instructions, 75 subroutines
;
CONSTANT SDC_Q0, 70   ; input port
CONSTANT SDC_Q1, 71   ; input port
CONSTANT SDC_Q2, 72   ; input port
CONSTANT SDC_Q3, 73   ; input port
CONSTANT DBG_STATUS, A0   ; input port
CONSTANT RTC_GAME_S, A5   ; input port
CONSTANT RTC_GAME_M, A6   ; input port
CONSTANT RTC_GAME_H, A7   ; input port
CONSTANT RTC_GAME_DL, A8   ; input port
CONSTANT RTC_GAME_DH, A9   ; input port
CONSTANT CMD_LBA0, B0   ; input port
CONSTANT CMD_LBA1, B1   ; input port
CONSTANT CMD_LBA2, B2   ; input port
CONSTANT CMD_LBA3, B3   ; input port
CONSTANT CMD_COUNT, B4   ; input port
CONSTANT CMD_OP, B5   ; input port
CONSTANT RTC_SET_DATA, B6   ; input port
CONSTANT RTC_WR_DAY, B8   ; input port
CONSTANT RTC_GAME_LIVE, B9   ; input port
CONSTANT TBL_Q3, C0   ; input port
CONSTANT TBL_Q2, C1   ; input port
CONSTANT TBL_Q1, C2   ; input port
CONSTANT TBL_Q0, C3   ; input port
CONSTANT I2C_IN, EB   ; input port
CONSTANT SDC_D0, 70   ; output port
CONSTANT SDC_D1, 71   ; output port
CONSTANT SDC_D2, 72   ; output port
CONSTANT SDC_D3, 73   ; output port
CONSTANT DBG_TX, A1   ; output port
CONSTANT RTC_BASE_S, A5   ; output port
CONSTANT RTC_BASE_M, A6   ; output port
CONSTANT RTC_BASE_H, A7   ; output port
CONSTANT RTC_BASE_DL, A8   ; output port
CONSTANT RTC_BASE_DH, A9   ; output port
CONSTANT TBL_INDEX, BF   ; output port
CONSTANT BANK_SELECT, C8   ; output port
CONSTANT LOAD_ADDR3, E0   ; output port
CONSTANT LOAD_ADDR2, E1   ; output port
CONSTANT LOAD_ADDR1, E2   ; output port
CONSTANT LOAD_ADDR0, E3   ; output port
CONSTANT I2C_OUT, EC   ; output port
CONSTANT RTC_REG_INDEX, ED   ; output port
CONSTANT RTC_REG_VALUE, EE   ; output port
CONSTANT LOAD_BUSY, EF   ; output port
CONSTANT RTC_SET_INDEX, F0   ; output port
CONSTANT acmd41_tries, 00   ; scratchpad
CONSTANT sd_version, 01   ; scratchpad
CONSTANT resp0, 02   ; scratchpad
CONSTANT resp1, 03   ; scratchpad
CONSTANT resp2, 04   ; scratchpad
CONSTANT resp3, 05   ; scratchpad
CONSTANT sd_is_sdhc, 06   ; scratchpad
CONSTANT cid0, 13   ; scratchpad
CONSTANT cid1, 14   ; scratchpad
CONSTANT cid2, 15   ; scratchpad
CONSTANT cid3, 16   ; scratchpad
CONSTANT rca_hi, 17   ; scratchpad
CONSTANT rca_lo, 18   ; scratchpad
CONSTANT xfer_dir, 19   ; scratchpad
CONSTANT dma_addr3, 1A   ; scratchpad
CONSTANT dma_addr2, 1B   ; scratchpad
CONSTANT dma_addr1, 1C   ; scratchpad
CONSTANT dma_addr0, 1D   ; scratchpad
CONSTANT blksize_hi, 1E   ; scratchpad
CONSTANT blksize_lo, 1F   ; scratchpad
CONSTANT blkcount_m1, 20   ; scratchpad
CONSTANT load_step_lo, 2A   ; scratchpad
CONSTANT load_pos3, 2C   ; scratchpad
CONSTANT load_pos2, 2D   ; scratchpad
CONSTANT load_pos1, 2E   ; scratchpad
CONSTANT load_pos0, 2F   ; scratchpad
CONSTANT load_step_hi, 31   ; scratchpad
CONSTANT rtc_el_s, 33   ; scratchpad
CONSTANT rtc_el_m, 34   ; scratchpad
CONSTANT rtc_el_h, 35   ; scratchpad
CONSTANT rtc_el_day, 36   ; scratchpad
CONSTANT rtc_last_sec, 37   ; scratchpad
CONSTANT tbl_mode, 3B   ; scratchpad
CONSTANT data_status, 3D   ; scratchpad
CONSTANT license_a, 3E   ; scratchpad
CONSTANT license_b, 3F   ; scratchpad


; Reset. Clear scratchpad, run bank 2 (license check, boot counter),
; bring the SD card up in native 4-bit mode, init the RTC, then idle
; with interrupts on. Kernel commands arrive as interrupts (int_vector).
reset:
    DISABLE INTERRUPT               ; 000 3C000
    LOAD s2, 00                     ; 001 00200
    STORE s2, license_b             ; 002 2E23F  license_b=0 tells bank 2 "boot", not "flash update"
    CALL call_bank2                 ; 003 303F0  bank 2: Device DNA + license check, boot tally at flash $70000
    FETCH sF, license_a             ; 004 06F3E  debug: print bank 2's verdict (F1 F2 = licensed)
    CALL dbg_putc                   ; 005 301AA
    FETCH sF, license_b             ; 006 06F3F
    CALL dbg_putc                   ; 007 301AA
    CALL clear_scratchpad           ; 008 30097  clear scratchpad $00-$3D
    CALL sdc_init                   ; 009 300FC  controller reset, timeouts, 400 kHz identification clock
    CALL delay_med                  ; 00A 301C2
    CALL sd_cmd0                    ; 00B 300A0  CMD0 GO_IDLE_STATE
    LOAD sF, B0                     ; 00C 00FB0  debug B0: card reset sent
    CALL dbg_putc                   ; 00D 301AA
    CALL delay_short                ; 00E 301BD
    CALL sd_cmd8                    ; 00F 300A3  CMD8 SEND_IF_COND $1AA (2.7-3.6 V, check pattern AA)
    CALL sdc_read_response          ; 010 30194
    FETCH s0, resp3                 ; 011 06005
    FETCH s0, resp3                 ; 012 06005
    COMPARE s0, AA                  ; 013 140AA  echoed check pattern AA = SD v2 card
    JUMP NZ, L_018                  ; 014 35418
    LOAD s0, 02                     ; 015 00002
    STORE s0, sd_version            ; 016 2E001
    JUMP L_018                      ; 017 34018
L_018:
    CALL sd_acmd41_loop             ; 018 300A8  ACMD41 loop until powered up
    CALL sd_cmd2                    ; 019 300E1  CMD2 ALL_SEND_CID
    CALL save_cid                   ; 01A 301A0  keep the CID's last word
    CALL delay_short                ; 01B 301BD
    CALL sd_cmd3                    ; 01C 300E4  CMD3 SEND_RELATIVE_ADDR
    CALL delay_med                  ; 01D 301C2
    CALL sdc_read_response          ; 01E 30194
    FETCH s0, resp0                 ; 01F 06002  RCA from the R6 response
    STORE s0, rca_hi                ; 020 2E017
    FETCH s0, resp1                 ; 021 06003
    STORE s0, rca_lo                ; 022 2E018
    LOAD s0, 00                     ; 023 00000  clock divider 0 = full speed
    CALL sdc_clock_divider          ; 024 30118
    CALL sdc_reset_off              ; 025 3011E
    CALL sd_cmd7                    ; 026 300E7  CMD7 SELECT_CARD
    LOAD s1, 02                     ; 027 00102
    LOAD s0, 00                     ; 028 00000
    CALL sd_cmd16                   ; 029 300F1  CMD16 SET_BLOCKLEN 512
    CALL sd_cmd55                   ; 02A 300CD  CMD55 APP_CMD
    CALL sd_acmd6_4bit              ; 02B 300EC  ACMD6 SET_BUS_WIDTH 4-bit
    CALL sdc_bus_4bit               ; 02C 3012B  controller to 4-bit bus
    CALL sd_cmd13                   ; 02D 300D2  CMD13 SEND_STATUS
    CALL rtc_init                   ; 02E 3031B  PCF8563 init
    LOAD sF, EE                     ; 02F 00FEE  debug EE: init done
    CALL dbg_putc                   ; 030 301AA
    ENABLE INTERRUPT                ; 031 3C001
L_032:
    LOAD sB, 02                     ; 032 00B02
    DISABLE INTERRUPT               ; 033 3C000
    CALL rtc_dump                   ; 034 30309  copy RTC registers 2-8 to ports ED/EE
    ENABLE INTERRUPT                ; 035 3C001
    INPUT s1, RTC_GAME_LIVE         ; 036 041B9  1 while a game with a clock runs (FW4: the kernel asks for a refresh)
    COMPARE s1, 01                  ; 037 14101
    JUMP NZ, L_08E                  ; 038 3548E
    LOAD sB, 02                     ; 039 00B02
    CALL rtc_read                   ; 03A 30303
    FETCH s0, rtc_last_sec          ; 03B 06037
    COMPARE s0, sD                  ; 03C 150D0
    JUMP Z, L_08E                   ; 03D 3508E
    STORE sD, rtc_last_sec          ; 03E 2ED37
    FETCH s0, rtc_el_s              ; 03F 06033
    COMPARE s0, 3B                  ; 040 1403B
    JUMP Z, L_045                   ; 041 35045
    ADD s0, 01                      ; 042 18001
    STORE s0, rtc_el_s              ; 043 2E033
    JUMP L_05A                      ; 044 3405A
L_045:
    LOAD s0, 00                     ; 045 00000
    STORE s0, rtc_el_s              ; 046 2E033
    FETCH s0, rtc_el_m              ; 047 06034
    COMPARE s0, 3B                  ; 048 1403B
    JUMP Z, L_04D                   ; 049 3504D
    ADD s0, 01                      ; 04A 18001
    STORE s0, rtc_el_m              ; 04B 2E034
    JUMP L_05A                      ; 04C 3405A
L_04D:
    LOAD s0, 00                     ; 04D 00000
    STORE s0, rtc_el_m              ; 04E 2E034
    FETCH s0, rtc_el_h              ; 04F 06035
    COMPARE s0, 17                  ; 050 14017
    JUMP Z, L_055                   ; 051 35055
    ADD s0, 01                      ; 052 18001
    STORE s0, rtc_el_h              ; 053 2E035
    JUMP L_05A                      ; 054 3405A
L_055:
    LOAD s0, 00                     ; 055 00000
    STORE s0, rtc_el_h              ; 056 2E035
    FETCH s0, rtc_el_day            ; 057 06036
    ADD s0, 01                      ; 058 18001
    STORE s0, rtc_el_day            ; 059 2E036
L_05A:
    FETCH s5, rtc_el_s              ; 05A 06533
    INPUT s4, RTC_GAME_S            ; 05B 044A5
    ADD s4, s5                      ; 05C 19450
    LOAD s3, 00                     ; 05D 00300
    LOAD s5, s4                     ; 05E 01540
    SUB s5, 3C                      ; 05F 1C53C
    JUMP C, L_063                   ; 060 35863
    SUB s4, 3C                      ; 061 1C43C
    ADD s3, 01                      ; 062 18301
L_063:
    OUTPUT s4, RTC_BASE_S           ; 063 2C4A5
    FETCH s5, rtc_el_m              ; 064 06534
    INPUT s4, RTC_GAME_M            ; 065 044A6
    ADD s4, s5                      ; 066 19450
    ADD s4, s3                      ; 067 19430
    LOAD s3, 00                     ; 068 00300
    LOAD s5, s4                     ; 069 01540
    SUB s5, 3C                      ; 06A 1C53C
    JUMP C, L_06E                   ; 06B 3586E
    SUB s4, 3C                      ; 06C 1C43C
    ADD s3, 01                      ; 06D 18301
L_06E:
    OUTPUT s4, RTC_BASE_M           ; 06E 2C4A6
    FETCH s5, rtc_el_h              ; 06F 06535
    INPUT s4, RTC_GAME_H            ; 070 044A7
    ADD s4, s5                      ; 071 19450
    ADD s4, s3                      ; 072 19430
    LOAD s3, 00                     ; 073 00300
    LOAD s5, s4                     ; 074 01540
    SUB s5, 18                      ; 075 1C518
    JUMP C, L_079                   ; 076 35879
    SUB s4, 18                      ; 077 1C418
    ADD s3, 01                      ; 078 18301
L_079:
    OUTPUT s4, RTC_BASE_H           ; 079 2C4A7
    FETCH s5, rtc_el_day            ; 07A 06536
    INPUT s4, RTC_GAME_DL           ; 07B 044A8
    ADD s4, s5                      ; 07C 19450
    JUMP C, L_081                   ; 07D 35881
    ADD s4, s3                      ; 07E 19430
    JUMP C, L_081                   ; 07F 35881
    JUMP L_08B                      ; 080 3408B
L_081:
    OUTPUT s4, RTC_BASE_DL          ; 081 2C4A8
    INPUT s4, RTC_GAME_DH           ; 082 044A9
    TEST s4, 01                     ; 083 12401
    JUMP Z, L_088                   ; 084 35088
    OR s4, 80                       ; 085 0C480
    OUTPUT s4, RTC_BASE_DH          ; 086 2C4A9
    JUMP L_08E                      ; 087 3408E
L_088:
    OR s4, 01                       ; 088 0C401
    OUTPUT s4, RTC_BASE_DH          ; 089 2C4A9
    JUMP L_08E                      ; 08A 3408E
L_08B:
    OUTPUT s4, RTC_BASE_DL          ; 08B 2C4A8
    INPUT s4, RTC_GAME_DH           ; 08C 044A9
    OUTPUT s4, RTC_BASE_DH          ; 08D 2C4A9
L_08E:
    CALL delay_long                 ; 08E 301C7  ~delay
    JUMP L_032                      ; 08F 34032
; $090-$096: unreached words, kept as data
ADDRESS 090
    ; 090: 301BD  CALL delay_short
    DATA_WORD 301BD
    ; 091: 00100  LOAD s1, 00
    DATA_WORD 00100
    ; 092: 2C1F2  OUTPUT s1, F2
    DATA_WORD 2C1F2
    ; 093: 00201  LOAD s2, 01
    DATA_WORD 00201
    ; 094: 2C2F2  OUTPUT s2, F2
    DATA_WORD 2C2F2
    ; 095: 2C1F2  OUTPUT s1, F2
    DATA_WORD 2C1F2
    ; 096: 2A000  RETURN
    DATA_WORD 2A000

; ---- clear_scratchpad ---- called from 008
clear_scratchpad:
    LOAD s6, 00                     ; 097 00600
    LOAD s4, 00                     ; 098 00400
L_099:
    COMPARE s4, 3E                  ; 099 1443E
    JUMP C, L_09C                   ; 09A 3589C
    JUMP L_09F                      ; 09B 3409F
L_09C:
    STORE s6, (s4)                  ; 09C 2F640
    ADD s4, 01                      ; 09D 18401
    JUMP L_099                      ; 09E 34099
L_09F:
    RETURN                          ; 09F 2A000

; ---- sd_cmd0 ---- called from 00B
sd_cmd0:
    LOAD sC, 00                     ; 0A0 00C00
    LOAD sB, 00                     ; 0A1 00B00
    JUMP sd_cmd_noarg               ; 0A2 340F6

; ---- sd_cmd8 ---- called from 00F
sd_cmd8:
    LOAD sC, 08                     ; 0A3 00C08
    LOAD sB, 15                     ; 0A4 00B15
    LOAD s8, 01                     ; 0A5 00801
    LOAD s7, AA                     ; 0A6 007AA
    JUMP sd_cmd_arg16               ; 0A7 340F8

; ---- sd_acmd41_loop ---- called from 018
sd_acmd41_loop:
    LOAD s3, FF                     ; 0A8 003FF
    STORE s3, acmd41_tries          ; 0A9 2E300
    LOAD s0, 00                     ; 0AA 00000
    STORE s0, rca_hi                ; 0AB 2E017
    STORE s0, rca_lo                ; 0AC 2E018
L_0AD:
    CALL sd_cmd55                   ; 0AD 300CD
    CALL delay_short                ; 0AE 301BD
    CALL sd_acmd41                  ; 0AF 300D4
    CALL delay_short                ; 0B0 301BD
    CALL sdc_read_response          ; 0B1 30194
    FETCH s0, resp0                 ; 0B2 06002
    TEST s0, 80                     ; 0B3 12080  response bit 31 = card powered up
    JUMP NZ, L_0BC                  ; 0B4 354BC
    FETCH s3, acmd41_tries          ; 0B5 06300
    SUB s3, 01                      ; 0B6 1C301
    STORE s3, acmd41_tries          ; 0B7 2E300
    COMPARE s3, 00                  ; 0B8 14300
    JUMP Z, L_0C8                   ; 0B9 350C8  255 tries then give up (reported as 88)
    CALL delay_long                 ; 0BA 301C7
    JUMP L_0AD                      ; 0BB 340AD
L_0BC:
    FETCH s0, sd_version            ; 0BC 06001  card ready
    COMPARE s0, 02                  ; 0BD 14002
    JUMP Z, L_0C1                   ; 0BE 350C1
    LOAD s0, 01                     ; 0BF 00001
    STORE s0, sd_version            ; 0C0 2E001
L_0C1:
    FETCH s0, resp0                 ; 0C1 06002
    TEST s0, 40                     ; 0C2 12040  CCS bit: high capacity
    JUMP Z, L_0C8                   ; 0C3 350C8
    LOAD s3, 01                     ; 0C4 00301
    LOAD sF, 82                     ; 0C5 00F82  debug 82: SDHC/SDXC
    CALL dbg_putc                   ; 0C6 301AA
    JUMP L_0CB                      ; 0C7 340CB
L_0C8:
    LOAD sF, 88                     ; 0C8 00F88  debug 88: standard capacity, or timed out
    CALL dbg_putc                   ; 0C9 301AA
    LOAD s3, 00                     ; 0CA 00300
L_0CB:
    STORE s3, sd_is_sdhc            ; 0CB 2E306
    RETURN                          ; 0CC 2A000

; ---- sd_cmd55 ---- called from 02A, 0AD
sd_cmd55:
    LOAD sC, 37                     ; 0CD 00C37
sd_cmd_rca_arg:
    LOAD sB, 15                     ; 0CE 00B15
    FETCH sA, rca_hi                ; 0CF 06A17
    FETCH s9, rca_lo                ; 0D0 06918
    JUMP L_0DD                      ; 0D1 340DD

; ---- sd_cmd13 ---- called from 02D, 33B
sd_cmd13:
    LOAD sC, 0D                     ; 0D2 00C0D
    JUMP sd_cmd_rca_arg             ; 0D3 340CE

; ---- sd_acmd41 ---- called from 0AF
sd_acmd41:
    LOAD sC, 29                     ; 0D4 00C29
    LOAD sB, 01                     ; 0D5 00B01
    LOAD sA, 00                     ; 0D6 00A00
    FETCH s0, sd_version            ; 0D7 06001
    COMPARE s0, 02                  ; 0D8 14002
    JUMP NZ, L_0DB                  ; 0D9 354DB
    OR sA, 40                       ; 0DA 0CA40  HCS only for v2 cards...
L_0DB:
    LOAD sA, 40                     ; 0DB 00A40  ...but overwritten here: HCS is always sent
    LOAD s9, 30                     ; 0DC 00930
L_0DD:
    LOAD s8, 00                     ; 0DD 00800
    LOAD s7, 00                     ; 0DE 00700
    CALL sd_command                 ; 0DF 3013C
    RETURN                          ; 0E0 2A000

; ---- sd_cmd2 ---- called from 019
sd_cmd2:
    LOAD sC, 02                     ; 0E1 00C02
    LOAD sB, 07                     ; 0E2 00B07
    JUMP sd_cmd_noarg               ; 0E3 340F6

; ---- sd_cmd3 ---- called from 01C
sd_cmd3:
    LOAD sC, 03                     ; 0E4 00C03
    LOAD sB, 15                     ; 0E5 00B15
    JUMP sd_cmd_noarg               ; 0E6 340F6

; ---- sd_cmd7 ---- called from 026
sd_cmd7:
    LOAD sC, 07                     ; 0E7 00C07
    LOAD sB, 15                     ; 0E8 00B15
    FETCH sA, rca_hi                ; 0E9 06A17
    FETCH s9, rca_lo                ; 0EA 06918
    JUMP L_0DD                      ; 0EB 340DD

; ---- sd_acmd6_4bit ---- called from 02B
sd_acmd6_4bit:
    LOAD sC, 06                     ; 0EC 00C06
    LOAD sB, 15                     ; 0ED 00B15
    LOAD s8, 00                     ; 0EE 00800
    LOAD s7, 02                     ; 0EF 00702
    JUMP sd_cmd_arg16               ; 0F0 340F8

; ---- sd_cmd16 ---- called from 029
sd_cmd16:
    LOAD sC, 10                     ; 0F1 00C10
    LOAD sB, 15                     ; 0F2 00B15
    LOAD s8, s1                     ; 0F3 01810
    LOAD s7, s0                     ; 0F4 01700
    JUMP sd_cmd_arg16               ; 0F5 340F8

; ---- sd_cmd_noarg ---- called from 1F0
sd_cmd_noarg:
    LOAD s8, 00                     ; 0F6 00800
    LOAD s7, 00                     ; 0F7 00700
sd_cmd_arg16:
    LOAD sA, 00                     ; 0F8 00A00
    LOAD s9, 00                     ; 0F9 00900
    CALL sd_command                 ; 0FA 3013C
    RETURN                          ; 0FB 2A000

; ---- sdc_init ---- called from 009
sdc_init:
    CALL sdc_cmd_timeout            ; 0FC 3010D
    CALL sdc_data_timeout           ; 0FD 30116
    CALL sdc_cmd_int_enable         ; 0FE 30120
    CALL sdc_data_int_enable        ; 0FF 30127
    CALL sdc_cmd_int_status         ; 100 30122
    CALL sdc_data_int_status        ; 101 30129
    LOAD s0, 00                     ; 102 00000
    CALL sdc_clock_divider          ; 103 30118
    CALL sdc_bus_1bit               ; 104 30131
    CALL sdc_reset_on               ; 105 3010A  software reset on, then off below
    LOAD s0, 48                     ; 106 00048  divider $48: ~400 kHz from a ~58 MHz clock
    CALL sdc_clock_divider          ; 107 30118
    CALL sdc_reset_off              ; 108 3011E
    RETURN                          ; 109 2A000

; ---- sdc_reset_on ---- called from 105
sdc_reset_on:
    LOAD sE, 28                     ; 10A 00E28
    CALL sdc_zero_upper             ; 10B 30137
    JUMP L_12D                      ; 10C 3412D

; ---- sdc_cmd_timeout ---- called from 0FC
sdc_cmd_timeout:
    LOAD sE, 20                     ; 10D 00E20
    LOAD sD, 00                     ; 10E 00D00
    OUTPUT sD, SDC_D3               ; 10F 2CD73
    OUTPUT sD, SDC_D2               ; 110 2CD72
    LOAD s1, 00                     ; 111 00100
    OUTPUT s1, SDC_D1               ; 112 2C171
    OUTPUT s1, SDC_D0               ; 113 2C170
    CALL sdc_write_reg              ; 114 301AF
    RETURN                          ; 115 2A000

; ---- sdc_data_timeout ---- called from 0FD
sdc_data_timeout:
    LOAD sE, 18                     ; 116 00E18
    JUMP sdc_write_zero_reg         ; 117 34133

; ---- sdc_clock_divider ---- called from 024, 103, 107
sdc_clock_divider:
    LOAD sE, 24                     ; 118 00E24
