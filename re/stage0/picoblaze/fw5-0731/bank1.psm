; Kernel command $20: load a ROM file from SD into game memory.
; The kernel fills a table (TBL_INDEX/TBL_Q*): entries $00-$7B are
; (file offset, SD address) pairs, $7C the file length, $7D enable,
; $7E the step per run (blocks, bytes). Refused unless bank 2
; found a valid license (license_a/b = F1 F2).

; ---- cmd_load_rom ---- called from 358
cmd_load_rom:
    FETCH sF, license_a             ; 1F2 06F3E
    CALL dbg_putc                   ; 1F3 301AA
    FETCH sF, license_b             ; 1F4 06F3F
    CALL dbg_putc                   ; 1F5 301AA
    FETCH s0, license_a             ; 1F6 0603E
    COMPARE s0, F1                  ; 1F7 140F1  license gate
    RETURN NZ                       ; 1F8 2B400
    FETCH s0, license_b             ; 1F9 0603F
    COMPARE s0, F2                  ; 1FA 140F2
    RETURN NZ                       ; 1FB 2B400
    LOAD s5, 7E                     ; 1FC 0057E  table $7E: run length
    CALL tbl_read                   ; 1FD 30248
    STORE s0, load_step_lo          ; 1FE 2E02A
    STORE s1, load_step_hi          ; 1FF 2E131
    SUB s0, 01                      ; 200 1C001
    STORE s0, blkcount_m1           ; 201 2E020
    LOAD s5, 7D                     ; 202 0057D  table $7D: enable
    CALL tbl_read                   ; 203 30248
    COMPARE s0, 01                  ; 204 14001
    JUMP Z, L_207                   ; 205 35207
    RETURN                          ; 206 2A000
L_207:
    LOAD s0, 01                     ; 207 00001
    OUTPUT s0, LOAD_BUSY            ; 208 2C0EF  raise LOAD_BUSY for the kernel
    INPUT s0, BB                    ; 209 040BB
    STORE s0, 2B                    ; 20A 2E02B
    CALL load_rom_loop              ; 20B 3020F
    LOAD s0, 00                     ; 20C 00000
    OUTPUT s0, LOAD_BUSY            ; 20D 2C0EF
    RETURN                          ; 20E 2A000

; ---- load_rom_loop ---- called from 20B
load_rom_loop:
    LOAD s0, 00                     ; 20F 00000
    STORE s0, load_pos3             ; 210 2E02C
    STORE s0, load_pos2             ; 211 2E02D
    STORE s0, load_pos1             ; 212 2E02E
    STORE s0, load_pos0             ; 213 2E02F
    LOAD s1, 00                     ; 214 00100
    STORE s1, tbl_mode              ; 215 2E13B
L_216:
    FETCH s7, load_pos0             ; 216 0672F  current destination offset to E0-E3
    OUTPUT s7, LOAD_ADDR3           ; 217 2C7E0
    FETCH s8, load_pos1             ; 218 0682E
    OUTPUT s8, LOAD_ADDR2           ; 219 2C8E1
    FETCH s9, load_pos2             ; 21A 0692D
    OUTPUT s9, LOAD_ADDR1           ; 21B 2C9E2
    FETCH sA, load_pos3             ; 21C 06A2C
    OUTPUT sA, LOAD_ADDR0           ; 21D 2CAE3
    CALL extent_lookup              ; 21E 30251  file offset -> SD address
    CALL sd_read_blocks             ; 21F 301D6
    CALL sd_cmd12_stop              ; 220 301EE
    FETCH s0, 2B                    ; 221 0602B
    COMPARE s0, 11                  ; 222 14011
    JUMP Z, L_225                   ; 223 35225
    CALL delay_long                 ; 224 301C7
L_225:
    FETCH s7, load_pos0             ; 225 0672F
    FETCH s8, load_pos1             ; 226 0682E
    FETCH s9, load_pos2             ; 227 0692D
    FETCH sA, load_pos3             ; 228 06A2C
    FETCH s0, load_step_lo          ; 229 0602A
    FETCH s1, load_step_hi          ; 22A 06131
    ADD s7, s0                      ; 22B 19700
    ADDCY s8, s1                    ; 22C 1B810
    ADDCY s9, 00                    ; 22D 1A900
    ADDCY sA, 00                    ; 22E 1AA00
    STORE s7, load_pos0             ; 22F 2E72F
    STORE s8, load_pos1             ; 230 2E82E
    STORE s9, load_pos2             ; 231 2E92D
    STORE sA, load_pos3             ; 232 2EA2C
    LOAD s5, 7C                     ; 233 0057C  table $7C: file length
    CALL tbl_read                   ; 234 30248
    SL0 s7                          ; 235 20706
    SLA s8                          ; 236 20800
    SLA s9                          ; 237 20900
    SLA sA                          ; 238 20A00
    SUB s7, s1                      ; 239 1D710
    SUBCY s8, s2                    ; 23A 1F820
    SUBCY s9, s3                    ; 23B 1F930
    JUMP C, L_216                   ; 23C 35A16  loop until the whole file is copied
    RETURN                          ; 23D 2A000

; Extent table lookup: table index from s6, offset by tbl_mode.

; ---- tbl_index ---- called from 252, 264, 26B
tbl_index:
    LOAD s5, s6                     ; 23E 01560
