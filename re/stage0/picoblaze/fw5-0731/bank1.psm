; Bit-banged I2C. I2C_OUT bit 0 = SCL, bit 1 = SDA (open drain);
; I2C_IN bit 0 = SCL (clock stretching), bit 1 = SDA.

; ---- i2c_idle ---- called from 2E0, 2F1
i2c_idle:
    LOAD sF, 01                     ; 290 00F01
    OR sF, 02                       ; 291 0CF02
    OUTPUT sF, I2C_OUT              ; 292 2CFEC
    RETURN                          ; 293 2A000

; ---- i2c_start ---- called from 2E1, 2F2, 2FC
i2c_start:
    CALL i2c_sda_high               ; 294 302C8
    CALL i2c_scl_high_wait          ; 295 302BF
    CALL i2c_delay3                 ; 296 302D5
    CALL i2c_sda_low                ; 297 302C5
    CALL i2c_delay2                 ; 298 302D6
    CALL i2c_scl_low                ; 299 302BB
    RETURN                          ; 29A 2A000

; ---- i2c_stop ---- called from 2EF, 307
i2c_stop:
    CALL i2c_sda_low                ; 29B 302C5
    CALL i2c_delay3                 ; 29C 302D5
    CALL i2c_scl_high_wait          ; 29D 302BF
    CALL i2c_delay2                 ; 29E 302D6
    CALL i2c_sda_high               ; 29F 302C8
    RETURN                          ; 2A0 2A000

