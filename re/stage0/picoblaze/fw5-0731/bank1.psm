; ---- sdc_bus_4bit ---- called from 02C
sdc_bus_4bit:
    LOAD sE, 1C                     ; 12B 00E1C
    CALL sdc_zero_upper             ; 12C 30137
L_12D:
    LOAD s1, 01                     ; 12D 00101
    OUTPUT s1, SDC_D0               ; 12E 2C170
    CALL sdc_write_reg              ; 12F 301AF
    RETURN                          ; 130 2A000

; ---- sdc_bus_1bit ---- called from 104
sdc_bus_1bit:
    LOAD sE, 1C                     ; 131 00E1C
    JUMP sdc_write_zero_reg         ; 132 34133
sdc_write_zero_reg:
    CALL sdc_zero_upper             ; 133 30137
    OUTPUT sD, SDC_D0               ; 134 2CD70
