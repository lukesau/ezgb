    LOAD sD, s0                     ; 11A 01D00
    OUTPUT sD, SDC_D0               ; 11B 2CD70
    CALL sdc_write_reg              ; 11C 301AF
    RETURN                          ; 11D 2A000

; ---- sdc_reset_off ---- called from 025, 108
sdc_reset_off:
    LOAD sE, 28                     ; 11E 00E28
    JUMP sdc_write_zero_reg         ; 11F 34133

; ---- sdc_cmd_int_enable ---- called from 0FE
sdc_cmd_int_enable:
    LOAD sE, 38                     ; 120 00E38
    JUMP sdc_write_zero_reg         ; 121 34133

; ---- sdc_cmd_int_status ---- called from 100
sdc_cmd_int_status:
    LOAD sE, 34                     ; 122 00E34
    JUMP sdc_write_zero_reg         ; 123 34133

