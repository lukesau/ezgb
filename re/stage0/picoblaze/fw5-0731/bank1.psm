; ---- read_cmd_lba ---- called from 34B, 352
read_cmd_lba:
    INPUT sA, CMD_LBA3              ; 27E 04AB3
    INPUT s9, CMD_LBA2              ; 27F 049B2
    INPUT s8, CMD_LBA1              ; 280 048B1
