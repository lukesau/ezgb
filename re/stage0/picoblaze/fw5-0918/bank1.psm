; Send an SD command through the controller.
; sC = command index, sB = response flags (b0 response, b1 136-bit,
; b2 CRC check, b3 busy, b4 index check), sA:s9:s8:s7 = argument,
; xfer_dir = 0 none / 1 read / 2 write. Waits for completion.

; ---- sd_command ---- called from 0F9, 114, 206
sd_command:
    LOAD s0, 00                     ; 156 00000
    TEST sB, 01                     ; 157 12B01
    JUMP Z, L_15E                   ; 158 3515E
    TEST sB, 02                     ; 159 12B02
    JUMP Z, L_15D                   ; 15A 3515D
    OR s0, 02                       ; 15B 0C002
    JUMP L_15E                      ; 15C 3415E
L_15D:
    OR s0, 01                       ; 15D 0C001
L_15E:
    TEST sB, 08                     ; 15E 12B08
    JUMP Z, L_161                   ; 15F 35161
    OR s0, 04                       ; 160 0C004
L_161:
    TEST sB, 04                     ; 161 12B04
    JUMP Z, L_164                   ; 162 35164
    OR s0, 08                       ; 163 0C008
L_164:
    TEST sB, 10                     ; 164 12B10
    JUMP Z, L_167                   ; 165 35167
    OR s0, 10                       ; 166 0C010
L_167:
    FETCH s1, xfer_dir              ; 167 06119  data transfer? set DMA address, block size, count first
    COMPARE s1, 01                  ; 168 14101
    JUMP NZ, L_16C                  ; 169 3556C
    OR s0, 20                       ; 16A 0C020
    JUMP L_16F                      ; 16B 3416F
L_16C:
    COMPARE s1, 02                  ; 16C 14102
    JUMP NZ, L_187                  ; 16D 35587
    OR s0, 40                       ; 16E 0C040
L_16F:
    LOAD sE, 60                     ; 16F 00E60  reg $60 DMA address
    FETCH s1, dma_addr3             ; 170 0611A
    OUTPUT s1, SDC_D3               ; 171 2C173
    FETCH s1, dma_addr2             ; 172 0611B
    OUTPUT s1, SDC_D2               ; 173 2C172
    FETCH s1, dma_addr1             ; 174 0611C
    OUTPUT s1, SDC_D1               ; 175 2C171
    FETCH s1, dma_addr0             ; 176 0611D
    OUTPUT s1, SDC_D0               ; 177 2C170
    CALL sdc_write_reg              ; 178 301C9
    LOAD sE, 44                     ; 179 00E44  reg $44 block size - 1
    LOAD s1, 00                     ; 17A 00100
    OUTPUT s1, SDC_D3               ; 17B 2C173
    OUTPUT s1, SDC_D2               ; 17C 2C172
    FETCH s1, blksize_hi            ; 17D 0611E
    OUTPUT s1, SDC_D1               ; 17E 2C171
    FETCH s1, blksize_lo            ; 17F 0611F
    OUTPUT s1, SDC_D0               ; 180 2C170
    CALL sdc_write_reg              ; 181 301C9
    LOAD sE, 48                     ; 182 00E48  reg $48 block count - 1
    CALL sdc_zero_upper             ; 183 30151
    FETCH s1, blkcount_m1           ; 184 06120
    OUTPUT s1, SDC_D0               ; 185 2C170
    CALL sdc_write_reg              ; 186 301C9
L_187:
    LOAD sE, 04                     ; 187 00E04  reg $04 command word
    OUTPUT sC, SDC_D1               ; 188 2CC71
    OUTPUT s0, SDC_D0               ; 189 2C070
    CALL sdc_write_reg              ; 18A 301C9
    LOAD sE, 00                     ; 18B 00E00  reg $00 argument (starts the command)
    OUTPUT sA, SDC_D3               ; 18C 2CA73
    OUTPUT s9, SDC_D2               ; 18D 2C972
    OUTPUT s8, SDC_D1               ; 18E 2C871
    OUTPUT s7, SDC_D0               ; 18F 2C770
    CALL sdc_write_reg              ; 190 301C9
L_191:
    LOAD sE, 34                     ; 191 00E34  reg $34 command event status
    CALL sdc_wait_ack               ; 192 301CB
    INPUT s0, SDC_Q0                ; 193 04070
    COMPARE s0, 06                  ; 194 14006
    JUMP Z, L_198                   ; 195 35198
    TEST s0, 01                     ; 196 12001
    JUMP Z, L_191                   ; 197 35191
L_198:
    LOAD sE, 34                     ; 198 00E34
    LOAD sD, 00                     ; 199 00D00
    OUTPUT sD, SDC_D0               ; 19A 2CD70
    CALL sdc_write_reg              ; 19B 301C9
    FETCH s1, xfer_dir              ; 19C 06119
    COMPARE s1, 00                  ; 19D 14100
    JUMP Z, L_1AD                   ; 19E 351AD
    LOAD sF, 55                     ; 19F 00F55  debug 55: waiting for data
    CALL dbg_putc                   ; 1A0 301C4
L_1A1:
    LOAD sE, 3C                     ; 1A1 00E3C  reg $3C data event status
    CALL sdc_wait_ack               ; 1A2 301CB
    INPUT s3, SDC_Q0                ; 1A3 04370
    TEST s3, 01                     ; 1A4 12301
    JUMP Z, L_1A1                   ; 1A5 351A1
    STORE s3, data_status           ; 1A6 2E33D
    LOAD sE, 3C                     ; 1A7 00E3C
    LOAD sD, 00                     ; 1A8 00D00
    OUTPUT sD, SDC_D0               ; 1A9 2CD70
    CALL sdc_write_reg              ; 1AA 301C9
    LOAD s1, 00                     ; 1AB 00100
    STORE s1, xfer_dir              ; 1AC 2E119
L_1AD:
    RETURN                          ; 1AD 2A000

; ---- sdc_read_response ---- called from 010, 01E, 0CB, 1BA, 356
sdc_read_response:
    LOAD sE, 08                     ; 1AE 00E08
    JUMP L_1B0                      ; 1AF 341B0
L_1B0:
    CALL sdc_wait_ack               ; 1B0 301CB
    INPUT s6, SDC_Q3                ; 1B1 04673
    STORE s6, resp0                 ; 1B2 2E602
    INPUT s5, SDC_Q2                ; 1B3 04572
    STORE s5, resp1                 ; 1B4 2E503
    INPUT s4, SDC_Q1                ; 1B5 04471
    STORE s4, resp2                 ; 1B6 2E404
    INPUT s3, SDC_Q0                ; 1B7 04370
    STORE s3, resp3                 ; 1B8 2E305
    RETURN                          ; 1B9 2A000

; ---- save_cid ---- called from 01A
save_cid:
    CALL sdc_read_response          ; 1BA 301AE
    FETCH s0, resp3                 ; 1BB 06005
    STORE s0, cid3                  ; 1BC 2E016
    FETCH s0, resp2                 ; 1BD 06004
    STORE s0, cid2                  ; 1BE 2E015
    FETCH s0, resp1                 ; 1BF 06003
    STORE s0, cid1                  ; 1C0 2E014
    FETCH s0, resp0                 ; 1C1 06002
    STORE s0, cid0                  ; 1C2 2E013
    RETURN                          ; 1C3 2A000

; Debug byte out (sF). Port A0 bit 2 = transmit busy.

; ---- dbg_putc ---- called from 005, 007, 00D, 030, 0E0, 0E3, 1A0, 20D, 20F, 385
dbg_putc:
    INPUT s0, DBG_STATUS            ; 1C4 040A0
    TEST s0, 04                     ; 1C5 12004
    JUMP NZ, dbg_putc               ; 1C6 355C4
    OUTPUT sF, DBG_TX               ; 1C7 2CFA1
    RETURN                          ; 1C8 2A000

; Controller register access: register number in sE, value in
; sD (low byte; ports 70-73 hold the full word). Polls the register
; port until an ack bit (0-1) is set.

; ---- sdc_write_reg ---- called from 12E, 136, 149, 14F, 178, 181, 186, 18A, 190, 19B, 1AA
sdc_write_reg:
    OUTPUT sD, (sE)                 ; 1C9 2DDE0
    JUMP sdc_wait_ack               ; 1CA 341CB

; ---- sdc_wait_ack ---- called from 192, 1A2, 1B0
sdc_wait_ack:
    INPUT sD, (sE)                  ; 1CB 05DE0
    TEST sD, 03                     ; 1CC 12D03
    JUMP Z, sdc_wait_ack            ; 1CD 351CB
    RETURN                          ; 1CE 2A000
; $1CF-$1D2: unreached words, kept as data
ADDRESS 1CF
    ; 1CF: 00003  LOAD s0, 03
    DATA_WORD 00003
    ; 1D0: 1C001  SUB s0, 01
    DATA_WORD 1C001
    ; 1D1: 355D0  JUMP NZ, 1D0
    DATA_WORD 355D0
    ; 1D2: 2A000  RETURN
    DATA_WORD 2A000

; ---- delay_tiny ---- called from 1D8
delay_tiny:
