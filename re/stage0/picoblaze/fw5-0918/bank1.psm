    CALL i2c_scl_high_wait          ; 2CC 302D9
    CALL i2c_delay2                 ; 2CD 302F0
    CALL i2c_scl_low                ; 2CE 302D5
    RETURN                          ; 2CF 2A000

; ---- i2c_nack ---- called from 320
i2c_nack:
