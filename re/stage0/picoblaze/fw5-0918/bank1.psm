; ---- i2c_delay2 ---- called from 2B2, 2B8, 2CD
i2c_delay2:
    CALL i2c_tick                   ; 2F0 302F5
    CALL i2c_tick                   ; 2F1 302F5

; ---- i2c_delay ---- called from 2E8, 2EC
i2c_delay:
    CALL i2c_tick                   ; 2F2 302F5
    CALL i2c_tick                   ; 2F3 302F5
    RETURN                          ; 2F4 2A000

; ---- i2c_tick ---- called from 2EF, 2F0, 2F1, 2F2, 2F3
i2c_tick:
    LOAD s0, 01                     ; 2F5 00001
L_2F6:
    SUB s0, 01                      ; 2F6 1C001
    JUMP NZ, L_2F6                  ; 2F7 356F6
    RETURN                          ; 2F8 2A000

; PCF8563 RTC at I2C address $51.

; ---- rtc_write_zero ---- called from 336, 340, 34B, 34D, 34F, 351, 353
rtc_write_zero:
    LOAD sD, 00                     ; 2F9 00D00

; ---- rtc_write ---- called from 330, 33E, 343, 346, 349
rtc_write:
    CALL i2c_idle                   ; 2FA 302AA
    CALL i2c_start                  ; 2FB 302AE
    LOAD s5, 51                     ; 2FC 00551  $51 << 1 = write address
    SL0 s5                          ; 2FD 20506
    CALL i2c_write_byte             ; 2FE 302BB
    CALL i2c_read_ack               ; 2FF 302D2
    RETURN C                        ; 300 2B800
    LOAD s5, sB                     ; 301 015B0
    CALL i2c_write_byte             ; 302 302BB
    CALL i2c_read_ack               ; 303 302D2
    RETURN C                        ; 304 2B800
    LOAD s5, sD                     ; 305 015D0
    CALL i2c_write_byte             ; 306 302BB
    CALL i2c_read_ack               ; 307 302D2
    RETURN C                        ; 308 2B800
    CALL i2c_stop                   ; 309 302B5
    RETURN                          ; 30A 2A000

; ---- rtc_select_read ---- called from 31D, 323
rtc_select_read:
    CALL i2c_idle                   ; 30B 302AA
    CALL i2c_start                  ; 30C 302AE
    LOAD s5, 51                     ; 30D 00551
    SL0 s5                          ; 30E 20506
    CALL i2c_write_byte             ; 30F 302BB
    CALL i2c_read_ack               ; 310 302D2
    RETURN C                        ; 311 2B800
    LOAD s5, sB                     ; 312 015B0
    CALL i2c_write_byte             ; 313 302BB
    CALL i2c_read_ack               ; 314 302D2
    RETURN C                        ; 315 2B800
    CALL i2c_start                  ; 316 302AE
    LOAD s5, 51                     ; 317 00551  $51 << 1 | 1 = read address
    SL1 s5                          ; 318 20507
    CALL i2c_write_byte             ; 319 302BB
    CALL i2c_read_ack               ; 31A 302D2
    RETURN C                        ; 31B 2B800
    RETURN                          ; 31C 2A000

; ---- rtc_read ---- called from 040, 338
rtc_read:
    CALL rtc_select_read            ; 31D 3030B
    CALL i2c_read_byte              ; 31E 302C5
    LOAD sD, s5                     ; 31F 01D50
L_320:
    CALL i2c_nack                   ; 320 302D0
    CALL i2c_stop                   ; 321 302B5
    RETURN                          ; 322 2A000

; Read RTC registers 2-8 (seconds..years) out to ports ED/EE.

; ---- rtc_dump ---- called from 038
rtc_dump:
    CALL rtc_select_read            ; 323 3030B
L_324:
    CALL i2c_read_byte              ; 324 302C5
    OUTPUT sB, RTC_REG_INDEX        ; 325 2CBED
    OUTPUT s5, RTC_REG_VALUE        ; 326 2C5EE
    COMPARE sB, 08                  ; 327 14B08
    JUMP Z, L_320                   ; 328 35320
    ADD sB, 01                      ; 329 18B01
    CALL i2c_ack_low                ; 32A 302CA
    JUMP L_324                      ; 32B 34324

; Kernel command $10: set RTC registers 2-8 from RTC_SET_DATA.

; ---- cmd_set_rtc ---- called from 386
cmd_set_rtc:
    LOAD sB, 02                     ; 32C 00B02
L_32D:
    OUTPUT sB, RTC_SET_INDEX        ; 32D 2CBF0
    LOAD s0, s0                     ; 32E 01000
    INPUT sD, RTC_SET_DATA          ; 32F 04DB6
    CALL rtc_write                  ; 330 302FA
    COMPARE sB, 08                  ; 331 14B08
    RETURN Z                        ; 332 2B000
    ADD sB, 01                      ; 333 18B01
    JUMP L_32D                      ; 334 3432D

; RTC init. If the seconds register's VL bit says the clock lost
; power, stop it and load a default date.

; ---- rtc_init ---- called from 02E
rtc_init:
    LOAD sB, 00                     ; 335 00B00
    CALL rtc_write_zero             ; 336 302F9
    LOAD sB, 02                     ; 337 00B02
    CALL rtc_read                   ; 338 3031D  seconds, bit 7 = VL (clock integrity lost)
    AND sD, 80                      ; 339 0AD80
    COMPARE sD, 80                  ; 33A 14D80
    RETURN NZ                       ; 33B 2B400
    LOAD sB, 00                     ; 33C 00B00
    LOAD sD, 20                     ; 33D 00D20
    CALL rtc_write                  ; 33E 302FA
    LOAD sB, 08                     ; 33F 00B08  years 0
    CALL rtc_write_zero             ; 340 302F9
    LOAD sB, 07                     ; 341 00B07
    LOAD sD, 01                     ; 342 00D01  month 1
    CALL rtc_write                  ; 343 302FA
    LOAD sB, 06                     ; 344 00B06
    LOAD sD, 03                     ; 345 00D03  weekday 3
    CALL rtc_write                  ; 346 302FA
    LOAD sB, 05                     ; 347 00B05
    LOAD sD, 01                     ; 348 00D01  day 1
    CALL rtc_write                  ; 349 302FA
    LOAD sB, 04                     ; 34A 00B04
    CALL rtc_write_zero             ; 34B 302F9
    LOAD sB, 03                     ; 34C 00B03
    CALL rtc_write_zero             ; 34D 302F9
    LOAD sB, 02                     ; 34E 00B02
    CALL rtc_write_zero             ; 34F 302F9
    LOAD sB, 01                     ; 350 00B01
    CALL rtc_write_zero             ; 351 302F9
    LOAD sB, 00                     ; 352 00B00
    CALL rtc_write_zero             ; 353 302F9
    RETURN                          ; 354 2A000

; ---- sd_wait_tran ---- called from 36D, 374
sd_wait_tran:
    CALL sd_cmd13                   ; 355 300EC
    CALL sdc_read_response          ; 356 301AE
    FETCH s0, resp2                 ; 357 06004
    COMPARE s0, 09                  ; 358 14009  card status byte = $09: TRAN state, ready for data
    JUMP NZ, L_35B                  ; 359 3575B
    RETURN                          ; 35A 2A000
L_35B:
    CALL sd_cmd12_stop              ; 35B 30208
    JUMP sd_wait_tran               ; 35C 34355

; Interrupt (0918). B8 = 1/2: the game wrote DL/DH; CMD_OP $04/$02/$01:
; it wrote S/M/H. Each takes the written value as the new base and zeroes
; that field's elapsed count. Otherwise the kernel commands as in FW4:
; $80 read sectors, $40 write, $20 load ROM (clears the elapsed clock),
; $10 set RTC, $08 bank 2 flash update.
isr:
    INPUT s3, RTC_WR_DAY            ; 35D 043B8
    COMPARE s3, 01                  ; 35E 14301
    JUMP NZ, L_365                  ; 35F 35765
    INPUT s4, RTC_GAME_DL           ; 360 044A8
    OUTPUT s4, RTC_BASE_DL          ; 361 2C4A8  game wrote DL: new base, restart the day count
    LOAD s4, 00                     ; 362 00400
    STORE s4, rtc_el_day            ; 363 2E436
    JUMP isr_done                   ; 364 343A3
L_365:
    COMPARE s3, 02                  ; 365 14302
    JUMP NZ, L_36A                  ; 366 3576A
    INPUT s4, RTC_GAME_DH           ; 367 044A9
    OUTPUT s4, RTC_BASE_DH          ; 368 2C4A9
    JUMP isr_done                   ; 369 343A3
L_36A:
    INPUT s3, CMD_OP                ; 36A 043B5
    COMPARE s3, 80                  ; 36B 14380
    JUMP NZ, L_372                  ; 36C 35772
    CALL sd_wait_tran               ; 36D 30355
    CALL read_cmd_lba               ; 36E 30298
    CALL sd_read_blocks             ; 36F 301F0
    CALL sd_cmd12_stop              ; 370 30208
    JUMP isr_done                   ; 371 343A3
L_372:
    COMPARE s3, 40                  ; 372 14340
    JUMP NZ, L_379                  ; 373 35779
    CALL sd_wait_tran               ; 374 30355
    CALL read_cmd_lba               ; 375 30298
    CALL sd_write_blocks            ; 376 301F8
    CALL sd_cmd12_stop              ; 377 30208
    JUMP isr_done                   ; 378 343A3
L_379:
    COMPARE s3, 20                  ; 379 14320
    JUMP NZ, L_382                  ; 37A 35782
    CALL cmd_load_rom               ; 37B 3020C
    LOAD s4, 00                     ; 37C 00400
    STORE s4, rtc_el_s              ; 37D 2E433  new ROM loaded: elapsed clock back to zero
    STORE s4, rtc_el_m              ; 37E 2E434
    STORE s4, rtc_el_h              ; 37F 2E435
    STORE s4, rtc_el_day            ; 380 2E436
    JUMP isr_done                   ; 381 343A3
L_382:
    COMPARE s3, 10                  ; 382 14310
    JUMP NZ, L_388                  ; 383 35788
    LOAD sF, AA                     ; 384 00FAA
    CALL dbg_putc                   ; 385 301C4
    CALL cmd_set_rtc                ; 386 3032C
    JUMP isr_done                   ; 387 343A3
L_388:
    COMPARE s3, 08                  ; 388 14308
    JUMP NZ, L_38E                  ; 389 3578E
    LOAD s2, 01                     ; 38A 00201
    STORE s2, license_b             ; 38B 2E23F
    CALL call_bank2                 ; 38C 303F0
    JUMP isr_done                   ; 38D 343A3
L_38E:
    COMPARE s3, 04                  ; 38E 14304
    JUMP NZ, L_395                  ; 38F 35795
    INPUT s4, RTC_GAME_S            ; 390 044A5
    OUTPUT s4, RTC_BASE_S           ; 391 2C4A5  game wrote S
    LOAD s4, 00                     ; 392 00400
    STORE s4, rtc_el_s              ; 393 2E433
    JUMP isr_done                   ; 394 343A3
L_395:
    COMPARE s3, 02                  ; 395 14302
    JUMP NZ, L_39C                  ; 396 3579C
    INPUT s4, RTC_GAME_M            ; 397 044A6
    OUTPUT s4, RTC_BASE_M           ; 398 2C4A6
    LOAD s4, 00                     ; 399 00400
    STORE s4, rtc_el_m              ; 39A 2E434
    JUMP isr_done                   ; 39B 343A3
L_39C:
    COMPARE s3, 01                  ; 39C 14301
    JUMP NZ, isr_done               ; 39D 357A3
    INPUT s4, RTC_GAME_H            ; 39E 044A7
    OUTPUT s4, RTC_BASE_H           ; 39F 2C4A7
    LOAD s4, 00                     ; 3A0 00400
    STORE s4, rtc_el_h              ; 3A1 2E435
    JUMP isr_done                   ; 3A2 343A3
isr_done:
    RETURNI ENABLE                  ; 3A3 38001
; $3A4-$3EF: 76 unused (zero) words
ADDRESS 3F0

; Switch to bank 2 (X3Y25) and back. The instruction after each
; OUTPUT is fetched before the switch lands, hence the no-ops;
; $3F3 in bank 2 is CALL $1B5.

; ---- call_bank2 ---- called from 003, 38C
call_bank2:
    LOAD s0, 01                     ; 3F0 00001
    OUTPUT s0, BANK_SELECT          ; 3F1 2C0C8
    LOAD s0, s0                     ; 3F2 01000
    LOAD s0, s0                     ; 3F3 01000  bank 2 executes CALL $1B5 here
    LOAD s0, 00                     ; 3F4 00000
    OUTPUT s0, BANK_SELECT          ; 3F5 2C0C8
    LOAD s0, s0                     ; 3F6 01000
    RETURN                          ; 3F7 2A000
; $3F8-$3FE: 7 unused (zero) words
ADDRESS 3FF
int_vector:
    JUMP isr                        ; 3FF 3435D
