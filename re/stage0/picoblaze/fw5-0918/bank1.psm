    CALL i2c_delay                  ; 2EC 302F2
    CALL i2c_scl_low                ; 2ED 302D5
    RETURN                          ; 2EE 2A000

; ---- i2c_delay3 ---- called from 2B0, 2B6, 2CB, 2D7, 2E6
i2c_delay3:
