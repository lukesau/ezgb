; Bit-banged I2C. I2C_OUT bit 0 = SCL, bit 1 = SDA (open drain);
; I2C_IN bit 0 = SCL (clock stretching), bit 1 = SDA.

; ---- i2c_idle ---- called from 2FA, 30B
i2c_idle:
    LOAD sF, 01                     ; 2AA 00F01
    OR sF, 02                       ; 2AB 0CF02
    OUTPUT sF, I2C_OUT              ; 2AC 2CFEC
    RETURN                          ; 2AD 2A000

; ---- i2c_start ---- called from 2FB, 30C, 316
i2c_start:
