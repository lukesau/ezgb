; ---- read_cmd_lba ---- called from 36E, 375
read_cmd_lba:
    INPUT sA, CMD_LBA3              ; 298 04AB3
    INPUT s9, CMD_LBA2              ; 299 049B2
    INPUT s8, CMD_LBA1              ; 29A 048B1
    INPUT s7, CMD_LBA0              ; 29B 047B0
