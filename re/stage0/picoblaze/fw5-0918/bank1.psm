; Read one 32-bit table entry: index s5 -> s3:s2:s1:s0.

; ---- tbl_read ---- called from 217, 21D, 24E, 26D, 27F, 286
tbl_read:
    OUTPUT s5, TBL_INDEX            ; 262 2C5BF
