    LOAD s4, s9                     ; 272 01490
    SUBCY s4, s2                    ; 273 1F420
    LOAD s4, sA                     ; 274 014A0
    SUBCY s4, s3                    ; 275 1F430
    JUMP C, L_27B                   ; 276 35A7B
