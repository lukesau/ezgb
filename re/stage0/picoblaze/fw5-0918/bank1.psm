; Kernel command $20: load a ROM file from SD into game memory.
; The kernel fills a table (TBL_INDEX/TBL_Q*): entries $00-$7B are
; (file offset, SD address) pairs, $7C the file length, $7D enable,
; $7E the step per run (blocks, bytes). Refused unless bank 2
; found a valid license (license_a/b = F1 F2).

; ---- cmd_load_rom ---- called from 37B
cmd_load_rom:
    FETCH sF, license_a             ; 20C 06F3E
    CALL dbg_putc                   ; 20D 301C4
    FETCH sF, license_b             ; 20E 06F3F
    CALL dbg_putc                   ; 20F 301C4
    FETCH s0, license_a             ; 210 0603E
    COMPARE s0, F1                  ; 211 140F1  license gate
    RETURN NZ                       ; 212 2B400
    FETCH s0, license_b             ; 213 0603F
    COMPARE s0, F2                  ; 214 140F2
    RETURN NZ                       ; 215 2B400
    LOAD s5, 7E                     ; 216 0057E  table $7E: run length
    CALL tbl_read                   ; 217 30262
    STORE s0, load_step_lo          ; 218 2E02A
    STORE s1, load_step_hi          ; 219 2E131
    SUB s0, 01                      ; 21A 1C001
    STORE s0, blkcount_m1           ; 21B 2E020
    LOAD s5, 7D                     ; 21C 0057D  table $7D: enable
    CALL tbl_read                   ; 21D 30262
    COMPARE s0, 01                  ; 21E 14001
    JUMP Z, L_221                   ; 21F 35221
    RETURN                          ; 220 2A000
L_221:
    LOAD s0, 01                     ; 221 00001
    OUTPUT s0, LOAD_BUSY            ; 222 2C0EF  raise LOAD_BUSY for the kernel
    INPUT s0, BB                    ; 223 040BB
    STORE s0, 2B                    ; 224 2E02B
    CALL load_rom_loop              ; 225 30229
    LOAD s0, 00                     ; 226 00000
    OUTPUT s0, LOAD_BUSY            ; 227 2C0EF
    RETURN                          ; 228 2A000

; ---- load_rom_loop ---- called from 225
load_rom_loop:
    LOAD s0, 00                     ; 229 00000
    STORE s0, load_pos3             ; 22A 2E02C
    STORE s0, load_pos2             ; 22B 2E02D
    STORE s0, load_pos1             ; 22C 2E02E
    STORE s0, load_pos0             ; 22D 2E02F
    LOAD s1, 00                     ; 22E 00100
    STORE s1, tbl_mode              ; 22F 2E13B
L_230:
    FETCH s7, load_pos0             ; 230 0672F  current destination offset to E0-E3
    OUTPUT s7, LOAD_ADDR3           ; 231 2C7E0
    FETCH s8, load_pos1             ; 232 0682E
    OUTPUT s8, LOAD_ADDR2           ; 233 2C8E1
    FETCH s9, load_pos2             ; 234 0692D
    OUTPUT s9, LOAD_ADDR1           ; 235 2C9E2
    FETCH sA, load_pos3             ; 236 06A2C
    OUTPUT sA, LOAD_ADDR0           ; 237 2CAE3
    CALL extent_lookup              ; 238 3026B  file offset -> SD address
    CALL sd_read_blocks             ; 239 301F0
    CALL sd_cmd12_stop              ; 23A 30208
    FETCH s0, 2B                    ; 23B 0602B
    COMPARE s0, 11                  ; 23C 14011
    JUMP Z, L_23F                   ; 23D 3523F
    CALL delay_long                 ; 23E 301E1
L_23F:
    FETCH s7, load_pos0             ; 23F 0672F
    FETCH s8, load_pos1             ; 240 0682E
    FETCH s9, load_pos2             ; 241 0692D
    FETCH sA, load_pos3             ; 242 06A2C
    FETCH s0, load_step_lo          ; 243 0602A
    FETCH s1, load_step_hi          ; 244 06131
    ADD s7, s0                      ; 245 19700
    ADDCY s8, s1                    ; 246 1B810
    ADDCY s9, 00                    ; 247 1A900
    ADDCY sA, 00                    ; 248 1AA00
    STORE s7, load_pos0             ; 249 2E72F
    STORE s8, load_pos1             ; 24A 2E82E
    STORE s9, load_pos2             ; 24B 2E92D
    STORE sA, load_pos3             ; 24C 2EA2C
    LOAD s5, 7C                     ; 24D 0057C  table $7C: file length
    CALL tbl_read                   ; 24E 30262
    SL0 s7                          ; 24F 20706
    SLA s8                          ; 250 20800
    SLA s9                          ; 251 20900
    SLA sA                          ; 252 20A00
    SUB s7, s1                      ; 253 1D710
    SUBCY s8, s2                    ; 254 1F820
    SUBCY s9, s3                    ; 255 1F930
    JUMP C, L_230                   ; 256 35A30  loop until the whole file is copied
    RETURN                          ; 257 2A000

; Extent table lookup: table index from s6, offset by tbl_mode.

; ---- tbl_index ---- called from 26C, 27E, 285
tbl_index:
    LOAD s5, s6                     ; 258 01560
    FETCH s4, tbl_mode              ; 259 0643B
    COMPARE s4, 00                  ; 25A 14400
    JUMP Z, L_261                   ; 25B 35261
    COMPARE s4, FF                  ; 25C 144FF
    JUMP Z, L_260                   ; 25D 35260
