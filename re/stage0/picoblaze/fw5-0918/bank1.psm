; ---- i2c_read_ack ---- called from 2FF, 303, 307, 310, 314, 31A
i2c_read_ack:
    CALL i2c_read_bit               ; 2D2 302E5
    TEST s5, 01                     ; 2D3 12501
    RETURN                          ; 2D4 2A000

; ---- i2c_scl_low ---- called from 2B3, 2CE, 2ED
i2c_scl_low:
    AND sF, 02                      ; 2D5 0AF02
    OUTPUT sF, I2C_OUT              ; 2D6 2CFEC
