    CALL tbl_index                  ; 285 30258
    CALL tbl_read                   ; 286 30262
    ADD s7, s0                      ; 287 19700
    ADDCY s8, s1                    ; 288 1B810
    ADDCY s9, s2                    ; 289 1B920
    ADDCY sA, s3                    ; 28A 1BA30
    CALL sector_to_card_addr        ; 28B 3028D
    RETURN                          ; 28C 2A000

; SDSC cards are byte-addressed: shift the sector number left 9.

; ---- sector_to_card_addr ---- called from 28B, 29C
sector_to_card_addr:
    FETCH s4, sd_is_sdhc            ; 28D 06406
