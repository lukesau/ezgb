    LOAD s9, s8                     ; 291 01980
    LOAD s8, s7                     ; 292 01870
    SL0 s8                          ; 293 20806
    SLA s9                          ; 294 20900
    SLA sA                          ; 295 20A00
    LOAD s7, 00                     ; 296 00700
L_297:
