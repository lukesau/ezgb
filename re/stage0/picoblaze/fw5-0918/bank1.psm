; D0X3Y1.BEL.BRAM
; KCPSM3 (PicoBlaze for Spartan-3), 1K x 18
; 910 reachable instructions, 75 subroutines
;
CONSTANT SDC_Q0, 70   ; input port
CONSTANT SDC_Q1, 71   ; input port
CONSTANT SDC_Q2, 72   ; input port
CONSTANT SDC_Q3, 73   ; input port
CONSTANT DBG_STATUS, A0   ; input port
CONSTANT RTC_GAME_S, A5   ; input port
CONSTANT RTC_GAME_M, A6   ; input port
CONSTANT RTC_GAME_H, A7   ; input port
CONSTANT RTC_GAME_DL, A8   ; input port
CONSTANT RTC_GAME_DH, A9   ; input port
CONSTANT CMD_LBA0, B0   ; input port
CONSTANT CMD_LBA1, B1   ; input port
CONSTANT CMD_LBA2, B2   ; input port
CONSTANT CMD_LBA3, B3   ; input port
CONSTANT CMD_COUNT, B4   ; input port
CONSTANT CMD_OP, B5   ; input port
CONSTANT RTC_SET_DATA, B6   ; input port
CONSTANT RTC_WR_DAY, B8   ; input port
CONSTANT RTC_GAME_LIVE, B9   ; input port
CONSTANT TBL_Q3, C0   ; input port
CONSTANT TBL_Q2, C1   ; input port
CONSTANT TBL_Q1, C2   ; input port
CONSTANT TBL_Q0, C3   ; input port
CONSTANT I2C_IN, EB   ; input port
CONSTANT SDC_D0, 70   ; output port
CONSTANT SDC_D1, 71   ; output port
CONSTANT SDC_D2, 72   ; output port
CONSTANT SDC_D3, 73   ; output port
CONSTANT DBG_TX, A1   ; output port
CONSTANT RTC_BASE_S, A5   ; output port
CONSTANT RTC_BASE_M, A6   ; output port
CONSTANT RTC_BASE_H, A7   ; output port
CONSTANT RTC_BASE_DL, A8   ; output port
CONSTANT RTC_BASE_DH, A9   ; output port
CONSTANT TBL_INDEX, BF   ; output port
CONSTANT BANK_SELECT, C8   ; output port
CONSTANT LOAD_ADDR3, E0   ; output port
CONSTANT LOAD_ADDR2, E1   ; output port
CONSTANT LOAD_ADDR1, E2   ; output port
CONSTANT LOAD_ADDR0, E3   ; output port
CONSTANT I2C_OUT, EC   ; output port
CONSTANT RTC_REG_INDEX, ED   ; output port
CONSTANT RTC_REG_VALUE, EE   ; output port
CONSTANT LOAD_BUSY, EF   ; output port
CONSTANT RTC_SET_INDEX, F0   ; output port
CONSTANT acmd41_tries, 00   ; scratchpad
CONSTANT sd_version, 01   ; scratchpad
CONSTANT resp0, 02   ; scratchpad
CONSTANT resp1, 03   ; scratchpad
CONSTANT resp2, 04   ; scratchpad
CONSTANT resp3, 05   ; scratchpad
CONSTANT sd_is_sdhc, 06   ; scratchpad
CONSTANT cid0, 13   ; scratchpad
CONSTANT cid1, 14   ; scratchpad
CONSTANT cid2, 15   ; scratchpad
CONSTANT cid3, 16   ; scratchpad
CONSTANT rca_hi, 17   ; scratchpad
CONSTANT rca_lo, 18   ; scratchpad
CONSTANT xfer_dir, 19   ; scratchpad
CONSTANT dma_addr3, 1A   ; scratchpad
CONSTANT dma_addr2, 1B   ; scratchpad
CONSTANT dma_addr1, 1C   ; scratchpad
CONSTANT dma_addr0, 1D   ; scratchpad
CONSTANT blksize_hi, 1E   ; scratchpad
CONSTANT blksize_lo, 1F   ; scratchpad
CONSTANT blkcount_m1, 20   ; scratchpad
CONSTANT load_step_lo, 2A   ; scratchpad
CONSTANT load_pos3, 2C   ; scratchpad
CONSTANT load_pos2, 2D   ; scratchpad
CONSTANT load_pos1, 2E   ; scratchpad
CONSTANT load_pos0, 2F   ; scratchpad
CONSTANT load_step_hi, 31   ; scratchpad
CONSTANT rtc_el_s, 33   ; scratchpad
CONSTANT rtc_el_m, 34   ; scratchpad
CONSTANT rtc_el_h, 35   ; scratchpad
CONSTANT rtc_el_day, 36   ; scratchpad
CONSTANT rtc_last_sec, 37   ; scratchpad
CONSTANT tbl_mode, 3B   ; scratchpad
CONSTANT data_status, 3D   ; scratchpad
CONSTANT license_a, 3E   ; scratchpad
CONSTANT license_b, 3F   ; scratchpad


; Reset. Clear scratchpad, run bank 2 (license check, boot counter),
; bring the SD card up in native 4-bit mode, init the RTC, then idle
; with interrupts on. Kernel commands arrive as interrupts (int_vector).
reset:
    DISABLE INTERRUPT               ; 000 3C000
    LOAD s2, 00                     ; 001 00200
    STORE s2, license_b             ; 002 2E23F  license_b=0 tells bank 2 "boot", not "flash update"
    CALL call_bank2                 ; 003 303F0  bank 2: Device DNA + license check, boot tally at flash $70000
    FETCH sF, license_a             ; 004 06F3E  debug: print bank 2's verdict (F1 F2 = licensed)
    CALL dbg_putc                   ; 005 301C4
    FETCH sF, license_b             ; 006 06F3F
    CALL dbg_putc                   ; 007 301C4
    CALL clear_scratchpad           ; 008 300B1  clear scratchpad $00-$3D
    CALL sdc_init                   ; 009 30116  controller reset, timeouts, 400 kHz identification clock
    CALL delay_med                  ; 00A 301DC
    CALL sd_cmd0                    ; 00B 300BA  CMD0 GO_IDLE_STATE
    LOAD sF, B0                     ; 00C 00FB0  debug B0: card reset sent
    CALL dbg_putc                   ; 00D 301C4
    CALL delay_short                ; 00E 301D7
    CALL sd_cmd8                    ; 00F 300BD  CMD8 SEND_IF_COND $1AA (2.7-3.6 V, check pattern AA)
    CALL sdc_read_response          ; 010 301AE
    FETCH s0, resp3                 ; 011 06005
    FETCH s0, resp3                 ; 012 06005
    COMPARE s0, AA                  ; 013 140AA  echoed check pattern AA = SD v2 card
    JUMP NZ, L_018                  ; 014 35418
    LOAD s0, 02                     ; 015 00002
    STORE s0, sd_version            ; 016 2E001
    JUMP L_018                      ; 017 34018
L_018:
    CALL sd_acmd41_loop             ; 018 300C2  ACMD41 loop until powered up
    CALL sd_cmd2                    ; 019 300FB  CMD2 ALL_SEND_CID
    CALL save_cid                   ; 01A 301BA  keep the CID's last word
    CALL delay_short                ; 01B 301D7
    CALL sd_cmd3                    ; 01C 300FE  CMD3 SEND_RELATIVE_ADDR
    CALL delay_med                  ; 01D 301DC
    CALL sdc_read_response          ; 01E 301AE
    FETCH s0, resp0                 ; 01F 06002  RCA from the R6 response
    STORE s0, rca_hi                ; 020 2E017
    FETCH s0, resp1                 ; 021 06003
    STORE s0, rca_lo                ; 022 2E018
    LOAD s0, 00                     ; 023 00000  clock divider 0 = full speed
    CALL sdc_clock_divider          ; 024 30132
    CALL sdc_reset_off              ; 025 30138
    CALL sd_cmd7                    ; 026 30101  CMD7 SELECT_CARD
    LOAD s1, 02                     ; 027 00102
    LOAD s0, 00                     ; 028 00000
    CALL sd_cmd16                   ; 029 3010B  CMD16 SET_BLOCKLEN 512
    CALL sd_cmd55                   ; 02A 300E7  CMD55 APP_CMD
    CALL sd_acmd6_4bit              ; 02B 30106  ACMD6 SET_BUS_WIDTH 4-bit
    CALL sdc_bus_4bit               ; 02C 30145  controller to 4-bit bus
    CALL sd_cmd13                   ; 02D 300EC  CMD13 SEND_STATUS
    CALL rtc_init                   ; 02E 30335  PCF8563 init
    LOAD sF, EE                     ; 02F 00FEE  debug EE: init done
    CALL dbg_putc                   ; 030 301C4
    ENABLE INTERRUPT                ; 031 3C001
idle:
    INPUT s1, RTC_GAME_LIVE         ; 032 041B9  1 while a game with a clock runs (FW4: the kernel asks for a refresh)
    COMPARE s1, 01                  ; 033 14101
    JUMP NZ, L_036                  ; 034 35436
    JUMP game_clock                 ; 035 3403C
L_036:
    LOAD sB, 02                     ; 036 00B02
    DISABLE INTERRUPT               ; 037 3C000
    CALL rtc_dump                   ; 038 30323  copy RTC registers 2-8 to ports ED/EE
    ENABLE INTERRUPT                ; 039 3C001
    CALL delay_long                 ; 03A 301E1  ~delay
    JUMP idle                       ; 03B 34032

; Game clock (RTC_REFRESH = 1): unless DH bit 6 (halt) is set, read the
; PCF8563 seconds and, when they change, carry one second through the
; elapsed S/M/H/day counters in scratchpad $33-$36.
game_clock:
    INPUT s1, RTC_GAME_DH           ; 03C 041A9
    TEST s1, 40                     ; 03D 12140  DH bit 6: clock halted
    JUMP NZ, L_0A9                  ; 03E 354A9
    LOAD sB, 02                     ; 03F 00B02
    CALL rtc_read                   ; 040 3031D
    FETCH s0, rtc_last_sec          ; 041 06037
    COMPARE s0, sD                  ; 042 150D0
    JUMP Z, L_0A9                   ; 043 350A9
    STORE sD, rtc_last_sec          ; 044 2ED37
    FETCH s0, rtc_el_s              ; 045 06033
    COMPARE s0, 3B                  ; 046 1403B
    JUMP Z, L_04B                   ; 047 3504B
    ADD s0, 01                      ; 048 18001
    STORE s0, rtc_el_s              ; 049 2E033
    JUMP L_060                      ; 04A 34060
L_04B:
    LOAD s0, 00                     ; 04B 00000
    STORE s0, rtc_el_s              ; 04C 2E033
    FETCH s0, rtc_el_m              ; 04D 06034
    COMPARE s0, 3B                  ; 04E 1403B
    JUMP Z, L_053                   ; 04F 35053
    ADD s0, 01                      ; 050 18001
    STORE s0, rtc_el_m              ; 051 2E034
    JUMP L_060                      ; 052 34060
L_053:
    LOAD s0, 00                     ; 053 00000
    STORE s0, rtc_el_m              ; 054 2E034
    FETCH s0, rtc_el_h              ; 055 06035
    COMPARE s0, 17                  ; 056 14017
    JUMP Z, L_05B                   ; 057 3505B
    ADD s0, 01                      ; 058 18001
    STORE s0, rtc_el_h              ; 059 2E035
    JUMP L_060                      ; 05A 34060
L_05B:
    LOAD s0, 00                     ; 05B 00000
    STORE s0, rtc_el_h              ; 05C 2E035
    FETCH s0, rtc_el_day            ; 05D 06036
    ADD s0, 01                      ; 05E 18001
    STORE s0, rtc_el_day            ; 05F 2E036
L_060:
    FETCH s5, rtc_el_s              ; 060 06533
    INPUT s4, RTC_GAME_S            ; 061 044A5
    LOAD s2, s4                     ; 062 01240
    SUB s2, 3C                      ; 063 1C23C
    JUMP C, L_069                   ; 064 35869
    ADD s4, 01                      ; 065 18401
    AND s4, 3F                      ; 066 0A43F
    LOAD s3, 00                     ; 067 00300
    JUMP L_070                      ; 068 34070
L_069:
    ADD s4, s5                      ; 069 19450
    LOAD s3, 00                     ; 06A 00300
    LOAD s5, s4                     ; 06B 01540
    SUB s5, 3C                      ; 06C 1C53C
    JUMP C, L_070                   ; 06D 35870
    SUB s4, 3C                      ; 06E 1C43C
    ADD s3, 01                      ; 06F 18301
L_070:
    OUTPUT s4, RTC_BASE_S           ; 070 2C4A5
    FETCH s5, rtc_el_m              ; 071 06534
    INPUT s4, RTC_GAME_M            ; 072 044A6
    LOAD s2, s4                     ; 073 01240
    SUB s2, 3C                      ; 074 1C23C
    JUMP C, L_07A                   ; 075 3587A
    ADD s4, s3                      ; 076 19430
    AND s4, 3F                      ; 077 0A43F
    LOAD s3, 00                     ; 078 00300
    JUMP L_082                      ; 079 34082
L_07A:
    ADD s4, s5                      ; 07A 19450
    ADD s4, s3                      ; 07B 19430
    LOAD s3, 00                     ; 07C 00300
    LOAD s5, s4                     ; 07D 01540
    SUB s5, 3C                      ; 07E 1C53C
    JUMP C, L_082                   ; 07F 35882
    SUB s4, 3C                      ; 080 1C43C
    ADD s3, 01                      ; 081 18301
L_082:
    OUTPUT s4, RTC_BASE_M           ; 082 2C4A6
    FETCH s5, rtc_el_h              ; 083 06535
    INPUT s4, RTC_GAME_H            ; 084 044A7
    LOAD s2, s4                     ; 085 01240
    SUB s2, 18                      ; 086 1C218
    JUMP C, L_08C                   ; 087 3588C
    ADD s4, s3                      ; 088 19430
    AND s4, 1F                      ; 089 0A41F
    LOAD s3, 00                     ; 08A 00300
    JUMP L_094                      ; 08B 34094
L_08C:
    ADD s4, s5                      ; 08C 19450
    ADD s4, s3                      ; 08D 19430
    LOAD s3, 00                     ; 08E 00300
    LOAD s5, s4                     ; 08F 01540
    SUB s5, 18                      ; 090 1C518
    JUMP C, L_094                   ; 091 35894
    SUB s4, 18                      ; 092 1C418
    ADD s3, 01                      ; 093 18301
L_094:
    OUTPUT s4, RTC_BASE_H           ; 094 2C4A7
    FETCH s5, rtc_el_day            ; 095 06536
    INPUT s4, RTC_GAME_DL           ; 096 044A8
    ADD s4, s5                      ; 097 19450
    JUMP C, L_09C                   ; 098 3589C
    ADD s4, s3                      ; 099 19430
    JUMP C, L_09C                   ; 09A 3589C
    JUMP L_0A6                      ; 09B 340A6
L_09C:
    OUTPUT s4, RTC_BASE_DL          ; 09C 2C4A8
    INPUT s4, RTC_GAME_DH           ; 09D 044A9
    TEST s4, 01                     ; 09E 12401
    JUMP Z, L_0A3                   ; 09F 350A3
    LOAD s4, 80                     ; 0A0 00480
    OUTPUT s4, RTC_BASE_DH          ; 0A1 2C4A9
    JUMP L_0A9                      ; 0A2 340A9
L_0A3:
    OR s4, 01                       ; 0A3 0C401
    OUTPUT s4, RTC_BASE_DH          ; 0A4 2C4A9
    JUMP L_0A9                      ; 0A5 340A9
L_0A6:
    OUTPUT s4, RTC_BASE_DL          ; 0A6 2C4A8
    INPUT s4, RTC_GAME_DH           ; 0A7 044A9
    OUTPUT s4, RTC_BASE_DH          ; 0A8 2C4A9
L_0A9:
    JUMP idle                       ; 0A9 34032
; $0AA-$0B0: unreached words, kept as data
ADDRESS 0AA
    ; 0AA: 301D7  CALL delay_short
    DATA_WORD 301D7
    ; 0AB: 00100  LOAD s1, 00
    DATA_WORD 00100
    ; 0AC: 2C1F2  OUTPUT s1, F2
    DATA_WORD 2C1F2
    ; 0AD: 00201  LOAD s2, 01
    DATA_WORD 00201
    ; 0AE: 2C2F2  OUTPUT s2, F2
    DATA_WORD 2C2F2
    ; 0AF: 2C1F2  OUTPUT s1, F2
    DATA_WORD 2C1F2
    ; 0B0: 2A000  RETURN
    DATA_WORD 2A000

; ---- clear_scratchpad ---- called from 008
clear_scratchpad:
    LOAD s6, 00                     ; 0B1 00600
    LOAD s4, 00                     ; 0B2 00400
L_0B3:
    COMPARE s4, 3E                  ; 0B3 1443E
    JUMP C, L_0B6                   ; 0B4 358B6
    JUMP L_0B9                      ; 0B5 340B9
L_0B6:
    STORE s6, (s4)                  ; 0B6 2F640
    ADD s4, 01                      ; 0B7 18401
    JUMP L_0B3                      ; 0B8 340B3
L_0B9:
    RETURN                          ; 0B9 2A000

; ---- sd_cmd0 ---- called from 00B
sd_cmd0:
    LOAD sC, 00                     ; 0BA 00C00
    LOAD sB, 00                     ; 0BB 00B00
    JUMP sd_cmd_noarg               ; 0BC 34110

; ---- sd_cmd8 ---- called from 00F
sd_cmd8:
    LOAD sC, 08                     ; 0BD 00C08
    LOAD sB, 15                     ; 0BE 00B15
    LOAD s8, 01                     ; 0BF 00801
    LOAD s7, AA                     ; 0C0 007AA
    JUMP sd_cmd_arg16               ; 0C1 34112

; ---- sd_acmd41_loop ---- called from 018
sd_acmd41_loop:
    LOAD s3, FF                     ; 0C2 003FF
    STORE s3, acmd41_tries          ; 0C3 2E300
    LOAD s0, 00                     ; 0C4 00000
    STORE s0, rca_hi                ; 0C5 2E017
    STORE s0, rca_lo                ; 0C6 2E018
L_0C7:
    CALL sd_cmd55                   ; 0C7 300E7
    CALL delay_short                ; 0C8 301D7
    CALL sd_acmd41                  ; 0C9 300EE
    CALL delay_short                ; 0CA 301D7
    CALL sdc_read_response          ; 0CB 301AE
    FETCH s0, resp0                 ; 0CC 06002
    TEST s0, 80                     ; 0CD 12080  response bit 31 = card powered up
    JUMP NZ, L_0D6                  ; 0CE 354D6
    FETCH s3, acmd41_tries          ; 0CF 06300
    SUB s3, 01                      ; 0D0 1C301
    STORE s3, acmd41_tries          ; 0D1 2E300
    COMPARE s3, 00                  ; 0D2 14300
    JUMP Z, L_0E2                   ; 0D3 350E2  255 tries then give up (reported as 88)
    CALL delay_long                 ; 0D4 301E1
    JUMP L_0C7                      ; 0D5 340C7
L_0D6:
    FETCH s0, sd_version            ; 0D6 06001  card ready
    COMPARE s0, 02                  ; 0D7 14002
    JUMP Z, L_0DB                   ; 0D8 350DB
    LOAD s0, 01                     ; 0D9 00001
    STORE s0, sd_version            ; 0DA 2E001
L_0DB:
    FETCH s0, resp0                 ; 0DB 06002
    TEST s0, 40                     ; 0DC 12040  CCS bit: high capacity
    JUMP Z, L_0E2                   ; 0DD 350E2
    LOAD s3, 01                     ; 0DE 00301
    LOAD sF, 82                     ; 0DF 00F82  debug 82: SDHC/SDXC
    CALL dbg_putc                   ; 0E0 301C4
    JUMP L_0E5                      ; 0E1 340E5
L_0E2:
    LOAD sF, 88                     ; 0E2 00F88  debug 88: standard capacity, or timed out
    CALL dbg_putc                   ; 0E3 301C4
    LOAD s3, 00                     ; 0E4 00300
L_0E5:
    STORE s3, sd_is_sdhc            ; 0E5 2E306
    RETURN                          ; 0E6 2A000

; ---- sd_cmd55 ---- called from 02A, 0C7
sd_cmd55:
    LOAD sC, 37                     ; 0E7 00C37
sd_cmd_rca_arg:
    LOAD sB, 15                     ; 0E8 00B15
    FETCH sA, rca_hi                ; 0E9 06A17
    FETCH s9, rca_lo                ; 0EA 06918
    JUMP L_0F7                      ; 0EB 340F7

; ---- sd_cmd13 ---- called from 02D, 355
sd_cmd13:
    LOAD sC, 0D                     ; 0EC 00C0D
    JUMP sd_cmd_rca_arg             ; 0ED 340E8

; ---- sd_acmd41 ---- called from 0C9
sd_acmd41:
    LOAD sC, 29                     ; 0EE 00C29
    LOAD sB, 01                     ; 0EF 00B01
    LOAD sA, 00                     ; 0F0 00A00
    FETCH s0, sd_version            ; 0F1 06001
    COMPARE s0, 02                  ; 0F2 14002
    JUMP NZ, L_0F5                  ; 0F3 354F5
    OR sA, 40                       ; 0F4 0CA40  HCS only for v2 cards...
L_0F5:
    LOAD sA, 40                     ; 0F5 00A40  ...but overwritten here: HCS is always sent
    LOAD s9, 30                     ; 0F6 00930
L_0F7:
    LOAD s8, 00                     ; 0F7 00800
    LOAD s7, 00                     ; 0F8 00700
    CALL sd_command                 ; 0F9 30156
    RETURN                          ; 0FA 2A000

; ---- sd_cmd2 ---- called from 019
sd_cmd2:
    LOAD sC, 02                     ; 0FB 00C02
    LOAD sB, 07                     ; 0FC 00B07
    JUMP sd_cmd_noarg               ; 0FD 34110

; ---- sd_cmd3 ---- called from 01C
sd_cmd3:
    LOAD sC, 03                     ; 0FE 00C03
    LOAD sB, 15                     ; 0FF 00B15
    JUMP sd_cmd_noarg               ; 100 34110

; ---- sd_cmd7 ---- called from 026
sd_cmd7:
    LOAD sC, 07                     ; 101 00C07
    LOAD sB, 15                     ; 102 00B15
    FETCH sA, rca_hi                ; 103 06A17
    FETCH s9, rca_lo                ; 104 06918
    JUMP L_0F7                      ; 105 340F7

; ---- sd_acmd6_4bit ---- called from 02B
sd_acmd6_4bit:
    LOAD sC, 06                     ; 106 00C06
    LOAD sB, 15                     ; 107 00B15
    LOAD s8, 00                     ; 108 00800
    LOAD s7, 02                     ; 109 00702
    JUMP sd_cmd_arg16               ; 10A 34112

; ---- sd_cmd16 ---- called from 029
sd_cmd16:
    LOAD sC, 10                     ; 10B 00C10
    LOAD sB, 15                     ; 10C 00B15
    LOAD s8, s1                     ; 10D 01810
    LOAD s7, s0                     ; 10E 01700
    JUMP sd_cmd_arg16               ; 10F 34112

; ---- sd_cmd_noarg ---- called from 20A
sd_cmd_noarg:
    LOAD s8, 00                     ; 110 00800
    LOAD s7, 00                     ; 111 00700
sd_cmd_arg16:
    LOAD sA, 00                     ; 112 00A00
    LOAD s9, 00                     ; 113 00900
    CALL sd_command                 ; 114 30156
    RETURN                          ; 115 2A000

; ---- sdc_init ---- called from 009
sdc_init:
    CALL sdc_cmd_timeout            ; 116 30127
    CALL sdc_data_timeout           ; 117 30130
    CALL sdc_cmd_int_enable         ; 118 3013A
    CALL sdc_data_int_enable        ; 119 30141
    CALL sdc_cmd_int_status         ; 11A 3013C
    CALL sdc_data_int_status        ; 11B 30143
    LOAD s0, 00                     ; 11C 00000
    CALL sdc_clock_divider          ; 11D 30132
    CALL sdc_bus_1bit               ; 11E 3014B
    CALL sdc_reset_on               ; 11F 30124  software reset on, then off below
    LOAD s0, 48                     ; 120 00048  divider $48: ~400 kHz from a ~58 MHz clock
    CALL sdc_clock_divider          ; 121 30132
    CALL sdc_reset_off              ; 122 30138
    RETURN                          ; 123 2A000

; ---- sdc_reset_on ---- called from 11F
sdc_reset_on:
    LOAD sE, 28                     ; 124 00E28
    CALL sdc_zero_upper             ; 125 30151
    JUMP L_147                      ; 126 34147

; ---- sdc_cmd_timeout ---- called from 116
sdc_cmd_timeout:
    LOAD sE, 20                     ; 127 00E20
    LOAD sD, 00                     ; 128 00D00
    OUTPUT sD, SDC_D3               ; 129 2CD73
    OUTPUT sD, SDC_D2               ; 12A 2CD72
    LOAD s1, 00                     ; 12B 00100
    OUTPUT s1, SDC_D1               ; 12C 2C171
    OUTPUT s1, SDC_D0               ; 12D 2C170
    CALL sdc_write_reg              ; 12E 301C9
    RETURN                          ; 12F 2A000

; ---- sdc_data_timeout ---- called from 117
sdc_data_timeout:
    LOAD sE, 18                     ; 130 00E18
    JUMP sdc_write_zero_reg         ; 131 3414D

; ---- sdc_clock_divider ---- called from 024, 11D, 121
sdc_clock_divider:
    LOAD sE, 24                     ; 132 00E24
    CALL sdc_zero_upper             ; 133 30151
    LOAD sD, s0                     ; 134 01D00
    OUTPUT sD, SDC_D0               ; 135 2CD70
    CALL sdc_write_reg              ; 136 301C9
    RETURN                          ; 137 2A000

; ---- sdc_reset_off ---- called from 025, 122
sdc_reset_off:
    LOAD sE, 28                     ; 138 00E28
    JUMP sdc_write_zero_reg         ; 139 3414D

; ---- sdc_cmd_int_enable ---- called from 118
sdc_cmd_int_enable:
    LOAD sE, 38                     ; 13A 00E38
    JUMP sdc_write_zero_reg         ; 13B 3414D

; ---- sdc_cmd_int_status ---- called from 11A
sdc_cmd_int_status:
    LOAD sE, 34                     ; 13C 00E34
    JUMP sdc_write_zero_reg         ; 13D 3414D

; ---- sdc_data_int_enable_on ---- called from 204
sdc_data_int_enable_on:
    LOAD sE, 40                     ; 13E 00E40
    CALL sdc_zero_upper             ; 13F 30151
    JUMP L_147                      ; 140 34147

; ---- sdc_data_int_enable ---- called from 119
sdc_data_int_enable:
    LOAD sE, 40                     ; 141 00E40
    JUMP sdc_write_zero_reg         ; 142 3414D

; ---- sdc_data_int_status ---- called from 11B
sdc_data_int_status:
    LOAD sE, 3C                     ; 143 00E3C
    JUMP sdc_write_zero_reg         ; 144 3414D

; ---- sdc_bus_4bit ---- called from 02C
sdc_bus_4bit:
    LOAD sE, 1C                     ; 145 00E1C
    CALL sdc_zero_upper             ; 146 30151
L_147:
    LOAD s1, 01                     ; 147 00101
    OUTPUT s1, SDC_D0               ; 148 2C170
    CALL sdc_write_reg              ; 149 301C9
    RETURN                          ; 14A 2A000

; ---- sdc_bus_1bit ---- called from 11E
sdc_bus_1bit:
    LOAD sE, 1C                     ; 14B 00E1C
    JUMP sdc_write_zero_reg         ; 14C 3414D
sdc_write_zero_reg:
