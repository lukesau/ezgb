    CALL i2c_delay3                 ; 2B0 302EF
    CALL i2c_sda_low                ; 2B1 302DF
    CALL i2c_delay2                 ; 2B2 302F0
    CALL i2c_scl_low                ; 2B3 302D5
    RETURN                          ; 2B4 2A000

; ---- i2c_stop ---- called from 309, 321
i2c_stop:
