    INPUT s2, TBL_Q2                ; 267 042C1
    INPUT s1, TBL_Q1                ; 268 041C2
    INPUT s0, TBL_Q0                ; 269 040C3
    RETURN                          ; 26A 2A000

; Find the extent holding file offset sA:s9:s8:s7 (linear scan,
; 2 entries per extent) and turn it into an SD address.

