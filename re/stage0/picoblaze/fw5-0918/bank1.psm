    RETURN                          ; 2D8 2A000

; ---- i2c_scl_high_wait ---- called from 2AF, 2B7, 2CC, 2E7
i2c_scl_high_wait:
    OR sF, 01                       ; 2D9 0CF01
    OUTPUT sF, I2C_OUT              ; 2DA 2CFEC
L_2DB:
    INPUT s0, I2C_IN                ; 2DB 040EB
    TEST s0, 01                     ; 2DC 12001
    JUMP Z, L_2DB                   ; 2DD 352DB
    RETURN                          ; 2DE 2A000

; ---- i2c_sda_low ---- called from 2B1, 2B5, 2BE, 2CA
i2c_sda_low:
    AND sF, 01                      ; 2DF 0AF01
    OUTPUT sF, I2C_OUT              ; 2E0 2CFEC
    RETURN                          ; 2E1 2A000

; ---- i2c_sda_high ---- called from 2AE, 2B9, 2C0, 2D0, 2E5
i2c_sda_high:
    OR sF, 02                       ; 2E2 0CF02
    OUTPUT sF, I2C_OUT              ; 2E3 2CFEC
    RETURN                          ; 2E4 2A000

; ---- i2c_read_bit ---- called from 2C6, 2D2
i2c_read_bit:
    CALL i2c_sda_high               ; 2E5 302E2
    CALL i2c_delay3                 ; 2E6 302EF
    CALL i2c_scl_high_wait          ; 2E7 302D9
    CALL i2c_delay                  ; 2E8 302F2
    INPUT s0, I2C_IN                ; 2E9 040EB
    TEST s0, 02                     ; 2EA 12002
