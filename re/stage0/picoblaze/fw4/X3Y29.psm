    LOAD s4, s9                     ; 2A4 01490
    SUBCY s4, s2                    ; 2A5 1F420
    LOAD s4, sA                     ; 2A6 014A0
    SUBCY s4, s3                    ; 2A7 1F430
    JUMP C, L_2AD                   ; 2A8 35AAD
    COMPARE s6, 7C                  ; 2A9 1467C
    JUMP Z, L_2AF                   ; 2AA 352AF
    ADD s6, 02                      ; 2AB 18602
    JUMP L_29E                      ; 2AC 3429E
L_2AD:
    SUB s6, 02                      ; 2AD 1C602
    JUMP L_2B0                      ; 2AE 342B0
L_2AF:
    LOAD s6, 00                     ; 2AF 00600
L_2B0:
    CALL tbl_index                  ; 2B0 3028A
    CALL tbl_read                   ; 2B1 30294
    SUB s7, s0                      ; 2B2 1D700
    SUBCY s8, s1                    ; 2B3 1F810
    SUBCY s9, s2                    ; 2B4 1F920
    SUBCY sA, s3                    ; 2B5 1FA30
    ADD s6, 01                      ; 2B6 18601
    CALL tbl_index                  ; 2B7 3028A
    CALL tbl_read                   ; 2B8 30294
    ADD s7, s0                      ; 2B9 19700
    ADDCY s8, s1                    ; 2BA 1B810
    ADDCY s9, s2                    ; 2BB 1B920
    ADDCY sA, s3                    ; 2BC 1BA30
    CALL sector_to_card_addr        ; 2BD 302BF
    RETURN                          ; 2BE 2A000

; SDSC cards are byte-addressed: shift the sector number left 9.

; ---- sector_to_card_addr ---- called from 2BD, 2CE
sector_to_card_addr:
    FETCH s4, sd_is_sdhc            ; 2BF 06406
    COMPARE s4, 01                  ; 2C0 14401
    JUMP Z, L_2C9                   ; 2C1 352C9
    LOAD sA, s9                     ; 2C2 01A90
    LOAD s9, s8                     ; 2C3 01980
    LOAD s8, s7                     ; 2C4 01870
    SL0 s8                          ; 2C5 20806
    SLA s9                          ; 2C6 20900
    SLA sA                          ; 2C7 20A00
    LOAD s7, 00                     ; 2C8 00700
L_2C9:
    RETURN                          ; 2C9 2A000

; ---- read_cmd_lba ---- called from 399, 3A0
read_cmd_lba:
    INPUT sA, CMD_LBA3              ; 2CA 04AB3
    INPUT s9, CMD_LBA2              ; 2CB 049B2
    INPUT s8, CMD_LBA1              ; 2CC 048B1
    INPUT s7, CMD_LBA0              ; 2CD 047B0
    CALL sector_to_card_addr        ; 2CE 302BF
    INPUT s1, CMD_COUNT             ; 2CF 041B4  CMD_COUNT -> block count - 1
    SUB s1, 01                      ; 2D0 1C101
    STORE s1, blkcount_m1           ; 2D1 2E120
    RETURN                          ; 2D2 2A000
; $2D3-$2DB: unreached words, kept as data
ADDRESS 2D3
    ; dead_pulse_e9:
    ; 2D3: 00000  LOAD s0, 00
    DATA_WORD 00000
    ; 2D4: 2C0E9  OUTPUT s0, E9
    DATA_WORD 2C0E9
    ; 2D5: 00001  LOAD s0, 01
    DATA_WORD 00001
    ; 2D6: 2C0E9  OUTPUT s0, E9
    DATA_WORD 2C0E9
    ; 2D7: 30160  CALL dead_delay
    DATA_WORD 30160
    ; 2D8: 00000  LOAD s0, 00
    DATA_WORD 00000
    ; 2D9: 2C0E9  OUTPUT s0, E9
    DATA_WORD 2C0E9
    ; 2DA: 00000  LOAD s0, 00
    DATA_WORD 00000
    ; 2DB: 2A000  RETURN
    DATA_WORD 2A000

; Bit-banged I2C. I2C_OUT bit 0 = SCL, bit 1 = SDA (open drain);
; I2C_IN bit 0 = SCL (clock stretching), bit 1 = SDA.

; ---- i2c_idle ---- called from 32C, 33D
i2c_idle:
    LOAD sF, 01                     ; 2DC 00F01
    OR sF, 02                       ; 2DD 0CF02
    OUTPUT sF, I2C_OUT              ; 2DE 2CFEC
    RETURN                          ; 2DF 2A000

; ---- i2c_start ---- called from 32D, 33E, 348
i2c_start:
    CALL i2c_sda_high               ; 2E0 30314
    CALL i2c_scl_high_wait          ; 2E1 3030B
    CALL i2c_delay3                 ; 2E2 30321
    CALL i2c_sda_low                ; 2E3 30311
    CALL i2c_delay2                 ; 2E4 30322
    CALL i2c_scl_low                ; 2E5 30307
    RETURN                          ; 2E6 2A000

; ---- i2c_stop ---- called from 33B, 353
i2c_stop:
    CALL i2c_sda_low                ; 2E7 30311
    CALL i2c_delay3                 ; 2E8 30321
    CALL i2c_scl_high_wait          ; 2E9 3030B
    CALL i2c_delay2                 ; 2EA 30322
    CALL i2c_sda_high               ; 2EB 30314
    RETURN                          ; 2EC 2A000

; ---- i2c_write_byte ---- called from 330, 334, 338, 341, 345, 34B
i2c_write_byte:
    LOAD s1, 80                     ; 2ED 00180
L_2EE:
    TEST s5, s1                     ; 2EE 13510
    JUMP NZ, L_2F2                  ; 2EF 356F2
    CALL i2c_sda_low                ; 2F0 30311
    JUMP L_2F3                      ; 2F1 342F3
L_2F2:
    CALL i2c_sda_high               ; 2F2 30314
L_2F3:
    CALL i2c_clock_pulse            ; 2F3 302FD
    SR0 s1                          ; 2F4 2010E
    RETURN C                        ; 2F5 2B800
    JUMP L_2EE                      ; 2F6 342EE

; ---- i2c_read_byte ---- called from 350, 356
i2c_read_byte:
    LOAD s1, 08                     ; 2F7 00108
L_2F8:
    CALL i2c_read_bit               ; 2F8 30317
    SUB s1, 01                      ; 2F9 1C101
    JUMP NZ, L_2F8                  ; 2FA 356F8
    RETURN                          ; 2FB 2A000

; ---- i2c_ack_low ---- called from 35C
i2c_ack_low:
    CALL i2c_sda_low                ; 2FC 30311

; ---- i2c_clock_pulse ---- called from 2F3
i2c_clock_pulse:
    CALL i2c_delay3                 ; 2FD 30321
    CALL i2c_scl_high_wait          ; 2FE 3030B
    CALL i2c_delay2                 ; 2FF 30322
    CALL i2c_scl_low                ; 300 30307
    RETURN                          ; 301 2A000

; ---- i2c_nack ---- called from 352
i2c_nack:
    CALL i2c_sda_high               ; 302 30314
    JUMP i2c_clock_pulse            ; 303 342FD

; ---- i2c_read_ack ---- called from 331, 335, 339, 342, 346, 34C
i2c_read_ack:
    CALL i2c_read_bit               ; 304 30317
    TEST s5, 01                     ; 305 12501
    RETURN                          ; 306 2A000

; ---- i2c_scl_low ---- called from 2E5, 300, 31F
i2c_scl_low:
    AND sF, 02                      ; 307 0AF02
    OUTPUT sF, I2C_OUT              ; 308 2CFEC
    CALL i2c_delay3                 ; 309 30321
    RETURN                          ; 30A 2A000

; ---- i2c_scl_high_wait ---- called from 2E1, 2E9, 2FE, 319
i2c_scl_high_wait:
    OR sF, 01                       ; 30B 0CF01
    OUTPUT sF, I2C_OUT              ; 30C 2CFEC
L_30D:
    INPUT s0, I2C_IN                ; 30D 040EB
    TEST s0, 01                     ; 30E 12001
    JUMP Z, L_30D                   ; 30F 3530D
    RETURN                          ; 310 2A000

; ---- i2c_sda_low ---- called from 2E3, 2E7, 2F0, 2FC
i2c_sda_low:
    AND sF, 01                      ; 311 0AF01
    OUTPUT sF, I2C_OUT              ; 312 2CFEC
    RETURN                          ; 313 2A000

; ---- i2c_sda_high ---- called from 2E0, 2EB, 2F2, 302, 317
i2c_sda_high:
    OR sF, 02                       ; 314 0CF02
    OUTPUT sF, I2C_OUT              ; 315 2CFEC
    RETURN                          ; 316 2A000

; ---- i2c_read_bit ---- called from 2F8, 304
i2c_read_bit:
    CALL i2c_sda_high               ; 317 30314
    CALL i2c_delay3                 ; 318 30321
    CALL i2c_scl_high_wait          ; 319 3030B
    CALL i2c_delay                  ; 31A 30324
    INPUT s0, I2C_IN                ; 31B 040EB
    TEST s0, 02                     ; 31C 12002
    SLA s5                          ; 31D 20500
    CALL i2c_delay                  ; 31E 30324
    CALL i2c_scl_low                ; 31F 30307
    RETURN                          ; 320 2A000

; ---- i2c_delay3 ---- called from 2E2, 2E8, 2FD, 309, 318
i2c_delay3:
    CALL i2c_tick                   ; 321 30327

; ---- i2c_delay2 ---- called from 2E4, 2EA, 2FF
i2c_delay2:
    CALL i2c_tick                   ; 322 30327
    CALL i2c_tick                   ; 323 30327

; ---- i2c_delay ---- called from 31A, 31E
i2c_delay:
    CALL i2c_tick                   ; 324 30327
    CALL i2c_tick                   ; 325 30327
    RETURN                          ; 326 2A000

; ---- i2c_tick ---- called from 321, 322, 323, 324, 325
i2c_tick:
    LOAD s0, 01                     ; 327 00001
L_328:
    SUB s0, 01                      ; 328 1C001
    JUMP NZ, L_328                  ; 329 35728
    RETURN                          ; 32A 2A000

; PCF8563 RTC at I2C address $51.

; ---- rtc_write_zero ---- called from 36E, 378, 383, 385, 387, 389, 38B
rtc_write_zero:
    LOAD sD, 00                     ; 32B 00D00

; ---- rtc_write ---- called from 362, 369, 36C, 376, 37B, 37E, 381
rtc_write:
    CALL i2c_idle                   ; 32C 302DC
    CALL i2c_start                  ; 32D 302E0
    LOAD s5, 51                     ; 32E 00551  $51 << 1 = write address
    SL0 s5                          ; 32F 20506
    CALL i2c_write_byte             ; 330 302ED
    CALL i2c_read_ack               ; 331 30304
    RETURN C                        ; 332 2B800
    LOAD s5, sB                     ; 333 015B0
    CALL i2c_write_byte             ; 334 302ED
    CALL i2c_read_ack               ; 335 30304
    RETURN C                        ; 336 2B800
    LOAD s5, sD                     ; 337 015D0
    CALL i2c_write_byte             ; 338 302ED
    CALL i2c_read_ack               ; 339 30304
    RETURN C                        ; 33A 2B800
    CALL i2c_stop                   ; 33B 302E7
    RETURN                          ; 33C 2A000

; ---- rtc_select_read ---- called from 34F, 355
rtc_select_read:
    CALL i2c_idle                   ; 33D 302DC
    CALL i2c_start                  ; 33E 302E0
    LOAD s5, 51                     ; 33F 00551
    SL0 s5                          ; 340 20506
    CALL i2c_write_byte             ; 341 302ED
    CALL i2c_read_ack               ; 342 30304
    RETURN C                        ; 343 2B800
    LOAD s5, sB                     ; 344 015B0
    CALL i2c_write_byte             ; 345 302ED
    CALL i2c_read_ack               ; 346 30304
    RETURN C                        ; 347 2B800
    CALL i2c_start                  ; 348 302E0
    LOAD s5, 51                     ; 349 00551  $51 << 1 | 1 = read address
    SL1 s5                          ; 34A 20507
    CALL i2c_write_byte             ; 34B 302ED
    CALL i2c_read_ack               ; 34C 30304
    RETURN C                        ; 34D 2B800
    RETURN                          ; 34E 2A000

; ---- rtc_read ---- called from 370
rtc_read:
    CALL rtc_select_read            ; 34F 3033D
    CALL i2c_read_byte              ; 350 302F7
    LOAD sD, s5                     ; 351 01D50
L_352:
    CALL i2c_nack                   ; 352 30302
    CALL i2c_stop                   ; 353 302E7
    RETURN                          ; 354 2A000

; Read RTC registers 2-8 (seconds..years) out to ports ED/EE.

; ---- rtc_dump ---- called from 037
rtc_dump:
    CALL rtc_select_read            ; 355 3033D
L_356:
    CALL i2c_read_byte              ; 356 302F7
    OUTPUT sB, RTC_REG_INDEX        ; 357 2CBED
    OUTPUT s5, RTC_REG_VALUE        ; 358 2C5EE
    COMPARE sB, 08                  ; 359 14B08
    JUMP Z, L_352                   ; 35A 35352
    ADD sB, 01                      ; 35B 18B01
    CALL i2c_ack_low                ; 35C 302FC
    JUMP L_356                      ; 35D 34356

; Kernel command $10: set RTC registers 2-8 from RTC_SET_DATA.

; ---- cmd_set_rtc ---- called from 3AA
cmd_set_rtc:
    LOAD sB, 02                     ; 35E 00B02
L_35F:
    OUTPUT sB, RTC_SET_INDEX        ; 35F 2CBF0
    LOAD s0, s0                     ; 360 01000
    INPUT sD, RTC_SET_DATA          ; 361 04DB6
    CALL rtc_write                  ; 362 3032C
    COMPARE sB, 08                  ; 363 14B08
    RETURN Z                        ; 364 2B000
    ADD sB, 01                      ; 365 18B01
    JUMP L_35F                      ; 366 3435F

; RTC init. If the seconds register's VL bit says the clock lost
; power, stop it and load a default date.

; ---- rtc_init ---- called from 02E
rtc_init:
    LOAD sB, 00                     ; 367 00B00
    LOAD sD, 20                     ; 368 00D20
    CALL rtc_write                  ; 369 3032C  control 1: STOP
    LOAD sB, 0D                     ; 36A 00B0D
    LOAD sD, 80                     ; 36B 00D80
    CALL rtc_write                  ; 36C 3032C  CLKOUT control
    LOAD sB, 00                     ; 36D 00B00
    CALL rtc_write_zero             ; 36E 3032B
    LOAD sB, 02                     ; 36F 00B02
    CALL rtc_read                   ; 370 3034F  seconds, bit 7 = VL (clock integrity lost)
    AND sD, 80                      ; 371 0AD80
    COMPARE sD, 80                  ; 372 14D80
    RETURN NZ                       ; 373 2B400
    LOAD sB, 00                     ; 374 00B00
    LOAD sD, 20                     ; 375 00D20
    CALL rtc_write                  ; 376 3032C
    LOAD sB, 08                     ; 377 00B08  years 0
    CALL rtc_write_zero             ; 378 3032B
    LOAD sB, 07                     ; 379 00B07
    LOAD sD, 01                     ; 37A 00D01  month 1
    CALL rtc_write                  ; 37B 3032C
    LOAD sB, 06                     ; 37C 00B06
    LOAD sD, 03                     ; 37D 00D03  weekday 3
    CALL rtc_write                  ; 37E 3032C
    LOAD sB, 05                     ; 37F 00B05
    LOAD sD, 01                     ; 380 00D01  day 1
    CALL rtc_write                  ; 381 3032C
    LOAD sB, 04                     ; 382 00B04
    CALL rtc_write_zero             ; 383 3032B
    LOAD sB, 03                     ; 384 00B03
    CALL rtc_write_zero             ; 385 3032B
    LOAD sB, 02                     ; 386 00B02
    CALL rtc_write_zero             ; 387 3032B
    LOAD sB, 01                     ; 388 00B01
    CALL rtc_write_zero             ; 389 3032B
    LOAD sB, 00                     ; 38A 00B00
    CALL rtc_write_zero             ; 38B 3032B
    RETURN                          ; 38C 2A000

; ---- sd_wait_tran ---- called from 398, 39F
sd_wait_tran:
    CALL sd_cmd13                   ; 38D 3007D
    CALL sdc_read_response          ; 38E 3013F
    FETCH s0, resp2                 ; 38F 06004
    COMPARE s0, 09                  ; 390 14009  card status byte = $09: TRAN state, ready for data
    JUMP NZ, L_393                  ; 391 35793
    RETURN                          ; 392 2A000
L_393:
    CALL sd_cmd12_stop              ; 393 301A3
    JUMP sd_wait_tran               ; 394 3438D

; Interrupt: the kernel wrote a command. CMD_OP:
; $80 read sectors, $40 write sectors, $20 load ROM,
; $10 set RTC, $08 run bank 2 in flash-update mode.
isr:
    INPUT s3, CMD_OP                ; 395 043B5
    COMPARE s3, 80                  ; 396 14380
    JUMP NZ, L_39D                  ; 397 3579D
    CALL sd_wait_tran               ; 398 3038D
    CALL read_cmd_lba               ; 399 302CA
    CALL sd_read_blocks             ; 39A 30181  CMD18 at CMD_LBA, CMD_COUNT blocks
    CALL sd_cmd12_stop              ; 39B 301A3
    JUMP isr_done                   ; 39C 343B2
L_39D:
    COMPARE s3, 40                  ; 39D 14340
    JUMP NZ, L_3A4                  ; 39E 357A4
    CALL sd_wait_tran               ; 39F 3038D
    CALL read_cmd_lba               ; 3A0 302CA
    CALL sd_write_blocks            ; 3A1 30189  CMD25
    CALL sd_cmd12_stop              ; 3A2 301A3
    JUMP isr_done                   ; 3A3 343B2
L_3A4:
    COMPARE s3, 20                  ; 3A4 14320
    JUMP NZ, L_3A8                  ; 3A5 357A8
    CALL cmd_load_rom               ; 3A6 301A7
    JUMP isr_done                   ; 3A7 343B2
L_3A8:
    COMPARE s3, 10                  ; 3A8 14310
    JUMP NZ, L_3AC                  ; 3A9 357AC
    CALL cmd_set_rtc                ; 3AA 3035E
    JUMP isr_done                   ; 3AB 343B2
L_3AC:
    COMPARE s3, 08                  ; 3AC 14308
    JUMP NZ, isr_done               ; 3AD 357B2
    LOAD s2, 01                     ; 3AE 00201  license_b=1 tells bank 2 "flash update"
    STORE s2, license_b             ; 3AF 2E23F
    CALL call_bank2                 ; 3B0 303F0
    JUMP isr_done                   ; 3B1 343B2
isr_done:
    RETURNI ENABLE                  ; 3B2 38001
; $3B3-$3EF: 61 unused (zero) words
ADDRESS 3F0

; Switch to bank 2 (X3Y25) and back. The instruction after each
; OUTPUT is fetched before the switch lands, hence the no-ops;
; $3F3 in bank 2 is CALL $1B5.

; ---- call_bank2 ---- called from 003, 3B0
call_bank2:
    LOAD s0, 01                     ; 3F0 00001
    OUTPUT s0, BANK_SELECT          ; 3F1 2C0C8
    LOAD s0, s0                     ; 3F2 01000
    LOAD s0, s0                     ; 3F3 01000  bank 2 executes CALL $1B5 here
    LOAD s0, 00                     ; 3F4 00000
    OUTPUT s0, BANK_SELECT          ; 3F5 2C0C8
    LOAD s0, s0                     ; 3F6 01000
    RETURN                          ; 3F7 2A000
; $3F8-$3FE: 7 unused (zero) words
ADDRESS 3FF
int_vector:
    JUMP isr                        ; 3FF 34395
