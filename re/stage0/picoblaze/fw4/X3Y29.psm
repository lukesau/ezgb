; Kernel command $20: load a ROM file from SD into game memory.
; The kernel fills a table (TBL_INDEX/TBL_Q*): entries $00-$7B are
; (file offset, SD address) pairs, $7C the file length, $7D enable,
; $7E the step per run (blocks, bytes). Refused unless bank 2
; found a valid license (license_a/b = F1 F2).

; ---- cmd_load_rom ---- called from 3A6
cmd_load_rom:
    FETCH sF, license_a             ; 1A7 06F3E
    CALL dbg_putc                   ; 1A8 30155
    FETCH sF, license_b             ; 1A9 06F3F
    CALL dbg_putc                   ; 1AA 30155
    FETCH s0, license_a             ; 1AB 0603E
    COMPARE s0, F1                  ; 1AC 140F1  license gate
    RETURN NZ                       ; 1AD 2B400
    FETCH s0, license_b             ; 1AE 0603F
    COMPARE s0, F2                  ; 1AF 140F2
    RETURN NZ                       ; 1B0 2B400
    LOAD s5, 7E                     ; 1B1 0057E  table $7E: run length
    CALL tbl_read                   ; 1B2 30294
    STORE s0, load_step_lo          ; 1B3 2E02A
    STORE s1, load_step_hi          ; 1B4 2E131
    SUB s0, 01                      ; 1B5 1C001
    STORE s0, blkcount_m1           ; 1B6 2E020
    LOAD s5, 7D                     ; 1B7 0057D  table $7D: enable
    CALL tbl_read                   ; 1B8 30294
    COMPARE s0, 01                  ; 1B9 14001
    JUMP Z, L_1BC                   ; 1BA 351BC
    RETURN                          ; 1BB 2A000
L_1BC:
    LOAD s0, 01                     ; 1BC 00001
    OUTPUT s0, LOAD_BUSY            ; 1BD 2C0EF  raise LOAD_BUSY for the kernel
    CALL load_rom_loop              ; 1BE 301C2
    LOAD s0, 00                     ; 1BF 00000
    OUTPUT s0, LOAD_BUSY            ; 1C0 2C0EF
    RETURN                          ; 1C1 2A000

; ---- load_rom_loop ---- called from 1BE
load_rom_loop:
    LOAD s0, 00                     ; 1C2 00000
    STORE s0, load_pos3             ; 1C3 2E02C
    STORE s0, load_pos2             ; 1C4 2E02D
    STORE s0, load_pos1             ; 1C5 2E02E
    STORE s0, load_pos0             ; 1C6 2E02F
    LOAD s1, 00                     ; 1C7 00100
    STORE s1, tbl_mode              ; 1C8 2E13B
L_1C9:
    FETCH s7, load_pos0             ; 1C9 0672F  current destination offset to E0-E3
    OUTPUT s7, LOAD_ADDR3           ; 1CA 2C7E0
    FETCH s8, load_pos1             ; 1CB 0682E
    OUTPUT s8, LOAD_ADDR2           ; 1CC 2C8E1
    FETCH s9, load_pos2             ; 1CD 0692D
    OUTPUT s9, LOAD_ADDR1           ; 1CE 2C9E2
    FETCH sA, load_pos3             ; 1CF 06A2C
    OUTPUT sA, LOAD_ADDR0           ; 1D0 2CAE3
    CALL extent_lookup              ; 1D1 3029D  file offset -> SD address
    CALL sd_read_blocks             ; 1D2 30181
    CALL sd_cmd12_stop              ; 1D3 301A3
    CALL delay_long                 ; 1D4 30172
    FETCH s7, load_pos0             ; 1D5 0672F
    FETCH s8, load_pos1             ; 1D6 0682E
    FETCH s9, load_pos2             ; 1D7 0692D
    FETCH sA, load_pos3             ; 1D8 06A2C
    FETCH s0, load_step_lo          ; 1D9 0602A
    FETCH s1, load_step_hi          ; 1DA 06131
    ADD s7, s0                      ; 1DB 19700
    ADDCY s8, s1                    ; 1DC 1B810
    ADDCY s9, 00                    ; 1DD 1A900
    ADDCY sA, 00                    ; 1DE 1AA00
    STORE s7, load_pos0             ; 1DF 2E72F
    STORE s8, load_pos1             ; 1E0 2E82E
    STORE s9, load_pos2             ; 1E1 2E92D
    STORE sA, load_pos3             ; 1E2 2EA2C
    LOAD s5, 7C                     ; 1E3 0057C  table $7C: file length
    CALL tbl_read                   ; 1E4 30294
    SL0 s7                          ; 1E5 20706
    SLA s8                          ; 1E6 20800
    SLA s9                          ; 1E7 20900
    SLA sA                          ; 1E8 20A00
    SUB s7, s1                      ; 1E9 1D710
    SUBCY s8, s2                    ; 1EA 1F820
    SUBCY s9, s3                    ; 1EB 1F930
    JUMP C, L_1C9                   ; 1EC 359C9  loop until the whole file is copied
    RETURN                          ; 1ED 2A000
