; Extent table lookup: table index from s6, offset by tbl_mode.

; ---- tbl_index ---- called from 29E, 2B0, 2B7
tbl_index:
    LOAD s5, s6                     ; 28A 01560
    FETCH s4, tbl_mode              ; 28B 0643B
    COMPARE s4, 00                  ; 28C 14400
    JUMP Z, L_293                   ; 28D 35293
    COMPARE s4, FF                  ; 28E 144FF
    JUMP Z, L_292                   ; 28F 35292
    ADD s5, C0                      ; 290 185C0
    RETURN                          ; 291 2A000
L_292:
    ADD s5, 80                      ; 292 18580
L_293:
    RETURN                          ; 293 2A000

; Read one 32-bit table entry: index s5 -> s3:s2:s1:s0.

; ---- tbl_read ---- called from 1B2, 1B8, 1E4, 29F, 2B1, 2B8
tbl_read:
    OUTPUT s5, TBL_INDEX            ; 294 2C5BF
    LOAD s1, s1                     ; 295 01110
    LOAD s1, s1                     ; 296 01110
    LOAD s1, s1                     ; 297 01110
    INPUT s3, TBL_Q3                ; 298 043C0
    INPUT s2, TBL_Q2                ; 299 042C1
    INPUT s1, TBL_Q1                ; 29A 041C2
    INPUT s0, TBL_Q0                ; 29B 040C3
    RETURN                          ; 29C 2A000

; Find the extent holding file offset sA:s9:s8:s7 (linear scan,
; 2 entries per extent) and turn it into an SD address.

; ---- extent_lookup ---- called from 1D1
extent_lookup:
