; Debug byte out (sF). Port A0 bit 2 = transmit busy.

; ---- dbg_putc ---- called from 005, 007, 00D, 030, 071, 074, 131, 198, 19A, 19C, 19E, 1A0, 1A8, 1AA
dbg_putc:
    INPUT s0, DBG_STATUS            ; 155 040A0
    TEST s0, 04                     ; 156 12004
    JUMP NZ, dbg_putc               ; 157 35555
    OUTPUT sF, DBG_TX               ; 158 2CFA1
    RETURN                          ; 159 2A000

; Controller register access: register number in sE, value in
; sD (low byte; ports 70-73 hold the full word). Polls the register
; port until an ack bit (0-1) is set.

; ---- sdc_write_reg ---- called from 0BF, 0C7, 0DA, 0E0, 109, 112, 117, 11B, 121, 12C, 13B
sdc_write_reg:
    OUTPUT sD, (sE)                 ; 15A 2DDE0
    JUMP sdc_wait_ack               ; 15B 3415C

; ---- sdc_wait_ack ---- called from 123, 133, 141
sdc_wait_ack:
    INPUT sD, (sE)                  ; 15C 05DE0
    TEST sD, 03                     ; 15D 12D03
    JUMP Z, sdc_wait_ack            ; 15E 3515C
    RETURN                          ; 15F 2A000
