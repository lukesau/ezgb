; D0X3Y29.BEL.BRAM
; KCPSM3 (PicoBlaze for Spartan-3), 1K x 18
; 769 reachable instructions, 75 subroutines
;
CONSTANT SDC_Q0, 70   ; input port
CONSTANT SDC_Q1, 71   ; input port
CONSTANT SDC_Q2, 72   ; input port
CONSTANT SDC_Q3, 73   ; input port
CONSTANT DBG_STATUS, A0   ; input port
CONSTANT CMD_LBA0, B0   ; input port
CONSTANT CMD_LBA1, B1   ; input port
CONSTANT CMD_LBA2, B2   ; input port
CONSTANT CMD_LBA3, B3   ; input port
CONSTANT CMD_COUNT, B4   ; input port
CONSTANT CMD_OP, B5   ; input port
CONSTANT RTC_SET_DATA, B6   ; input port
CONSTANT RTC_REFRESH, B9   ; input port
CONSTANT TBL_Q3, C0   ; input port
CONSTANT TBL_Q2, C1   ; input port
CONSTANT TBL_Q1, C2   ; input port
CONSTANT TBL_Q0, C3   ; input port
CONSTANT I2C_IN, EB   ; input port
CONSTANT SDC_D0, 70   ; output port
CONSTANT SDC_D1, 71   ; output port
CONSTANT SDC_D2, 72   ; output port
CONSTANT SDC_D3, 73   ; output port
CONSTANT DBG_TX, A1   ; output port
CONSTANT TBL_INDEX, BF   ; output port
CONSTANT BANK_SELECT, C8   ; output port
CONSTANT LOAD_ADDR3, E0   ; output port
CONSTANT LOAD_ADDR2, E1   ; output port
CONSTANT LOAD_ADDR1, E2   ; output port
CONSTANT LOAD_ADDR0, E3   ; output port
CONSTANT I2C_OUT, EC   ; output port
CONSTANT RTC_REG_INDEX, ED   ; output port
CONSTANT RTC_REG_VALUE, EE   ; output port
CONSTANT LOAD_BUSY, EF   ; output port
CONSTANT RTC_SET_INDEX, F0   ; output port
CONSTANT acmd41_tries, 00   ; scratchpad
CONSTANT sd_version, 01   ; scratchpad
CONSTANT resp0, 02   ; scratchpad
CONSTANT resp1, 03   ; scratchpad
CONSTANT resp2, 04   ; scratchpad
CONSTANT resp3, 05   ; scratchpad
CONSTANT sd_is_sdhc, 06   ; scratchpad
CONSTANT cid0, 13   ; scratchpad
CONSTANT cid1, 14   ; scratchpad
CONSTANT cid2, 15   ; scratchpad
CONSTANT cid3, 16   ; scratchpad
CONSTANT rca_hi, 17   ; scratchpad
CONSTANT rca_lo, 18   ; scratchpad
CONSTANT xfer_dir, 19   ; scratchpad
CONSTANT dma_addr3, 1A   ; scratchpad
CONSTANT dma_addr2, 1B   ; scratchpad
CONSTANT dma_addr1, 1C   ; scratchpad
CONSTANT dma_addr0, 1D   ; scratchpad
CONSTANT blksize_hi, 1E   ; scratchpad
CONSTANT blksize_lo, 1F   ; scratchpad
CONSTANT blkcount_m1, 20   ; scratchpad
CONSTANT load_step_lo, 2A   ; scratchpad
CONSTANT load_pos3, 2C   ; scratchpad
CONSTANT load_pos2, 2D   ; scratchpad
CONSTANT load_pos1, 2E   ; scratchpad
CONSTANT load_pos0, 2F   ; scratchpad
CONSTANT load_step_hi, 31   ; scratchpad
CONSTANT tbl_mode, 3B   ; scratchpad
CONSTANT data_status, 3D   ; scratchpad
CONSTANT license_a, 3E   ; scratchpad
CONSTANT license_b, 3F   ; scratchpad


; Reset. Clear scratchpad, run bank 2 (license check, boot counter),
; bring the SD card up in native 4-bit mode, init the RTC, then idle
; with interrupts on. Kernel commands arrive as interrupts (int_vector).
reset:
    DISABLE INTERRUPT               ; 000 3C000
    LOAD s2, 00                     ; 001 00200
    STORE s2, license_b             ; 002 2E23F  license_b=0 tells bank 2 "boot", not "flash update"
    CALL call_bank2                 ; 003 303F0  bank 2: Device DNA + license check, boot tally at flash $70000
    FETCH sF, license_a             ; 004 06F3E  debug: print bank 2's verdict (F1 F2 = licensed)
    CALL dbg_putc                   ; 005 30155
    FETCH sF, license_b             ; 006 06F3F
    CALL dbg_putc                   ; 007 30155
    CALL clear_scratchpad           ; 008 30042  clear scratchpad $00-$3D
    CALL sdc_init                   ; 009 300A7  controller reset, timeouts, 400 kHz identification clock
    CALL delay_med                  ; 00A 3016D
    CALL sd_cmd0                    ; 00B 3004B  CMD0 GO_IDLE_STATE
    LOAD sF, B0                     ; 00C 00FB0  debug B0: card reset sent
    CALL dbg_putc                   ; 00D 30155
    CALL delay_short                ; 00E 30168
    CALL sd_cmd8                    ; 00F 3004E  CMD8 SEND_IF_COND $1AA (2.7-3.6 V, check pattern AA)
    CALL sdc_read_response          ; 010 3013F
    FETCH s0, resp3                 ; 011 06005
    FETCH s0, resp3                 ; 012 06005
    COMPARE s0, AA                  ; 013 140AA  echoed check pattern AA = SD v2 card
    JUMP NZ, L_018                  ; 014 35418
    LOAD s0, 02                     ; 015 00002
    STORE s0, sd_version            ; 016 2E001
    JUMP L_018                      ; 017 34018
L_018:
    CALL sd_acmd41_loop             ; 018 30053  ACMD41 loop until powered up
    CALL sd_cmd2                    ; 019 3008C  CMD2 ALL_SEND_CID
    CALL save_cid                   ; 01A 3014B  keep the CID's last word
    CALL delay_short                ; 01B 30168
    CALL sd_cmd3                    ; 01C 3008F  CMD3 SEND_RELATIVE_ADDR
    CALL delay_med                  ; 01D 3016D
    CALL sdc_read_response          ; 01E 3013F
    FETCH s0, resp0                 ; 01F 06002  RCA from the R6 response
    STORE s0, rca_hi                ; 020 2E017
    FETCH s0, resp1                 ; 021 06003
    STORE s0, rca_lo                ; 022 2E018
    LOAD s0, 00                     ; 023 00000  clock divider 0 = full speed
    CALL sdc_clock_divider          ; 024 300C3
    CALL sdc_reset_off              ; 025 300C9
    CALL sd_cmd7                    ; 026 30092  CMD7 SELECT_CARD
    LOAD s1, 02                     ; 027 00102
    LOAD s0, 00                     ; 028 00000
    CALL sd_cmd16                   ; 029 3009C  CMD16 SET_BLOCKLEN 512
    CALL sd_cmd55                   ; 02A 30078  CMD55 APP_CMD
    CALL sd_acmd6_4bit              ; 02B 30097  ACMD6 SET_BUS_WIDTH 4-bit
    CALL sdc_bus_4bit               ; 02C 300D6  controller to 4-bit bus
    CALL sd_cmd13                   ; 02D 3007D  CMD13 SEND_STATUS
    CALL rtc_init                   ; 02E 30367  PCF8563 init
    LOAD sF, EE                     ; 02F 00FEE  debug EE: init done
    CALL dbg_putc                   ; 030 30155
    ENABLE INTERRUPT                ; 031 3C001
idle:
    INPUT s1, RTC_REFRESH           ; 032 041B9  kernel asks for a clock refresh
    COMPARE s1, 01                  ; 033 14101
    JUMP NZ, L_039                  ; 034 35439
    LOAD sB, 02                     ; 035 00B02
    DISABLE INTERRUPT               ; 036 3C000
    CALL rtc_dump                   ; 037 30355  copy RTC registers 2-8 to ports ED/EE
    ENABLE INTERRUPT                ; 038 3C001
L_039:
    CALL delay_long                 ; 039 30172  ~delay
    JUMP idle                       ; 03A 34032
; $03B-$041: unreached words, kept as data
ADDRESS 03B
    ; dead_pulse_f2:
    ; 03B: 30168  CALL delay_short
    DATA_WORD 30168
    ; 03C: 00100  LOAD s1, 00
    DATA_WORD 00100
    ; 03D: 2C1F2  OUTPUT s1, F2
    DATA_WORD 2C1F2
    ; 03E: 00201  LOAD s2, 01
    DATA_WORD 00201
    ; 03F: 2C2F2  OUTPUT s2, F2
    DATA_WORD 2C2F2
    ; 040: 2C1F2  OUTPUT s1, F2
    DATA_WORD 2C1F2
    ; 041: 2A000  RETURN
    DATA_WORD 2A000

; ---- clear_scratchpad ---- called from 008
clear_scratchpad:
    LOAD s6, 00                     ; 042 00600
    LOAD s4, 00                     ; 043 00400
L_044:
    COMPARE s4, 3E                  ; 044 1443E
    JUMP C, L_047                   ; 045 35847
    JUMP L_04A                      ; 046 3404A
L_047:
    STORE s6, (s4)                  ; 047 2F640
    ADD s4, 01                      ; 048 18401
    JUMP L_044                      ; 049 34044
L_04A:
    RETURN                          ; 04A 2A000

; ---- sd_cmd0 ---- called from 00B
sd_cmd0:
    LOAD sC, 00                     ; 04B 00C00
    LOAD sB, 00                     ; 04C 00B00
    JUMP sd_cmd_noarg               ; 04D 340A1

; ---- sd_cmd8 ---- called from 00F
sd_cmd8:
    LOAD sC, 08                     ; 04E 00C08
    LOAD sB, 15                     ; 04F 00B15
    LOAD s8, 01                     ; 050 00801
    LOAD s7, AA                     ; 051 007AA
    JUMP sd_cmd_arg16               ; 052 340A3

; ---- sd_acmd41_loop ---- called from 018
sd_acmd41_loop:
    LOAD s3, FF                     ; 053 003FF
    STORE s3, acmd41_tries          ; 054 2E300
    LOAD s0, 00                     ; 055 00000
    STORE s0, rca_hi                ; 056 2E017
    STORE s0, rca_lo                ; 057 2E018
L_058:
    CALL sd_cmd55                   ; 058 30078
    CALL delay_short                ; 059 30168
    CALL sd_acmd41                  ; 05A 3007F
    CALL delay_short                ; 05B 30168
    CALL sdc_read_response          ; 05C 3013F
    FETCH s0, resp0                 ; 05D 06002
    TEST s0, 80                     ; 05E 12080  response bit 31 = card powered up
    JUMP NZ, L_067                  ; 05F 35467
    FETCH s3, acmd41_tries          ; 060 06300
    SUB s3, 01                      ; 061 1C301
    STORE s3, acmd41_tries          ; 062 2E300
    COMPARE s3, 00                  ; 063 14300
    JUMP Z, L_073                   ; 064 35073  255 tries then give up (reported as 88)
    CALL delay_long                 ; 065 30172
    JUMP L_058                      ; 066 34058
L_067:
    FETCH s0, sd_version            ; 067 06001  card ready
    COMPARE s0, 02                  ; 068 14002
    JUMP Z, L_06C                   ; 069 3506C
    LOAD s0, 01                     ; 06A 00001
    STORE s0, sd_version            ; 06B 2E001
L_06C:
    FETCH s0, resp0                 ; 06C 06002
    TEST s0, 40                     ; 06D 12040  CCS bit: high capacity
    JUMP Z, L_073                   ; 06E 35073
    LOAD s3, 01                     ; 06F 00301
    LOAD sF, 82                     ; 070 00F82  debug 82: SDHC/SDXC
    CALL dbg_putc                   ; 071 30155
    JUMP L_076                      ; 072 34076
L_073:
    LOAD sF, 88                     ; 073 00F88  debug 88: standard capacity, or timed out
    CALL dbg_putc                   ; 074 30155
    LOAD s3, 00                     ; 075 00300
L_076:
    STORE s3, sd_is_sdhc            ; 076 2E306
    RETURN                          ; 077 2A000

; ---- sd_cmd55 ---- called from 02A, 058
sd_cmd55:
    LOAD sC, 37                     ; 078 00C37
sd_cmd_rca_arg:
    LOAD sB, 15                     ; 079 00B15
    FETCH sA, rca_hi                ; 07A 06A17
    FETCH s9, rca_lo                ; 07B 06918
    JUMP L_088                      ; 07C 34088

; ---- sd_cmd13 ---- called from 02D, 38D
sd_cmd13:
    LOAD sC, 0D                     ; 07D 00C0D
    JUMP sd_cmd_rca_arg             ; 07E 34079

; ---- sd_acmd41 ---- called from 05A
sd_acmd41:
    LOAD sC, 29                     ; 07F 00C29
    LOAD sB, 01                     ; 080 00B01
    LOAD sA, 00                     ; 081 00A00
    FETCH s0, sd_version            ; 082 06001
    COMPARE s0, 02                  ; 083 14002
    JUMP NZ, L_086                  ; 084 35486
    OR sA, 40                       ; 085 0CA40  HCS only for v2 cards...
L_086:
    LOAD sA, 40                     ; 086 00A40  ...but overwritten here: HCS is always sent
    LOAD s9, 30                     ; 087 00930
L_088:
    LOAD s8, 00                     ; 088 00800
    LOAD s7, 00                     ; 089 00700
    CALL sd_command                 ; 08A 300E7
    RETURN                          ; 08B 2A000

; ---- sd_cmd2 ---- called from 019
sd_cmd2:
    LOAD sC, 02                     ; 08C 00C02
    LOAD sB, 07                     ; 08D 00B07
    JUMP sd_cmd_noarg               ; 08E 340A1

; ---- sd_cmd3 ---- called from 01C
sd_cmd3:
    LOAD sC, 03                     ; 08F 00C03
    LOAD sB, 15                     ; 090 00B15
    JUMP sd_cmd_noarg               ; 091 340A1

; ---- sd_cmd7 ---- called from 026
sd_cmd7:
    LOAD sC, 07                     ; 092 00C07
    LOAD sB, 15                     ; 093 00B15
    FETCH sA, rca_hi                ; 094 06A17
    FETCH s9, rca_lo                ; 095 06918
    JUMP L_088                      ; 096 34088

; ---- sd_acmd6_4bit ---- called from 02B
sd_acmd6_4bit:
    LOAD sC, 06                     ; 097 00C06
    LOAD sB, 15                     ; 098 00B15
    LOAD s8, 00                     ; 099 00800
    LOAD s7, 02                     ; 09A 00702
    JUMP sd_cmd_arg16               ; 09B 340A3

; ---- sd_cmd16 ---- called from 029
sd_cmd16:
    LOAD sC, 10                     ; 09C 00C10
    LOAD sB, 15                     ; 09D 00B15
    LOAD s8, s1                     ; 09E 01810
    LOAD s7, s0                     ; 09F 01700
    JUMP sd_cmd_arg16               ; 0A0 340A3

; ---- sd_cmd_noarg ---- called from 1A5
sd_cmd_noarg:
    LOAD s8, 00                     ; 0A1 00800
    LOAD s7, 00                     ; 0A2 00700
sd_cmd_arg16:
    LOAD sA, 00                     ; 0A3 00A00
    LOAD s9, 00                     ; 0A4 00900
    CALL sd_command                 ; 0A5 300E7
    RETURN                          ; 0A6 2A000

; ---- sdc_init ---- called from 009
sdc_init:
    CALL sdc_cmd_timeout            ; 0A7 300B8
    CALL sdc_data_timeout           ; 0A8 300C1
    CALL sdc_cmd_int_enable         ; 0A9 300CB
    CALL sdc_data_int_enable        ; 0AA 300D2
    CALL sdc_cmd_int_status         ; 0AB 300CD
    CALL sdc_data_int_status        ; 0AC 300D4
    LOAD s0, 00                     ; 0AD 00000
    CALL sdc_clock_divider          ; 0AE 300C3
    CALL sdc_bus_1bit               ; 0AF 300DC
    CALL sdc_reset_on               ; 0B0 300B5  software reset on, then off below
    LOAD s0, 48                     ; 0B1 00048  divider $48: ~400 kHz from a ~58 MHz clock
    CALL sdc_clock_divider          ; 0B2 300C3
    CALL sdc_reset_off              ; 0B3 300C9
    RETURN                          ; 0B4 2A000

; ---- sdc_reset_on ---- called from 0B0
sdc_reset_on:
    LOAD sE, 28                     ; 0B5 00E28
    CALL sdc_zero_upper             ; 0B6 300E2
    JUMP L_0D8                      ; 0B7 340D8

; ---- sdc_cmd_timeout ---- called from 0A7
sdc_cmd_timeout:
    LOAD sE, 20                     ; 0B8 00E20
    LOAD sD, 00                     ; 0B9 00D00
    OUTPUT sD, SDC_D3               ; 0BA 2CD73
    OUTPUT sD, SDC_D2               ; 0BB 2CD72
    LOAD s1, 00                     ; 0BC 00100
    OUTPUT s1, SDC_D1               ; 0BD 2C171
    OUTPUT s1, SDC_D0               ; 0BE 2C170
    CALL sdc_write_reg              ; 0BF 3015A
    RETURN                          ; 0C0 2A000

; ---- sdc_data_timeout ---- called from 0A8
sdc_data_timeout:
    LOAD sE, 18                     ; 0C1 00E18
    JUMP sdc_write_zero_reg         ; 0C2 340DE

; ---- sdc_clock_divider ---- called from 024, 0AE, 0B2
sdc_clock_divider:
    LOAD sE, 24                     ; 0C3 00E24
    CALL sdc_zero_upper             ; 0C4 300E2
    LOAD sD, s0                     ; 0C5 01D00
    OUTPUT sD, SDC_D0               ; 0C6 2CD70
    CALL sdc_write_reg              ; 0C7 3015A
    RETURN                          ; 0C8 2A000

; ---- sdc_reset_off ---- called from 025, 0B3
sdc_reset_off:
    LOAD sE, 28                     ; 0C9 00E28
    JUMP sdc_write_zero_reg         ; 0CA 340DE

; ---- sdc_cmd_int_enable ---- called from 0A9
sdc_cmd_int_enable:
    LOAD sE, 38                     ; 0CB 00E38
    JUMP sdc_write_zero_reg         ; 0CC 340DE

; ---- sdc_cmd_int_status ---- called from 0AB
sdc_cmd_int_status:
    LOAD sE, 34                     ; 0CD 00E34
    JUMP sdc_write_zero_reg         ; 0CE 340DE

; ---- sdc_data_int_enable_on ---- called from 195
sdc_data_int_enable_on:
    LOAD sE, 40                     ; 0CF 00E40
    CALL sdc_zero_upper             ; 0D0 300E2
    JUMP L_0D8                      ; 0D1 340D8

; ---- sdc_data_int_enable ---- called from 0AA
sdc_data_int_enable:
    LOAD sE, 40                     ; 0D2 00E40
    JUMP sdc_write_zero_reg         ; 0D3 340DE

; ---- sdc_data_int_status ---- called from 0AC
sdc_data_int_status:
    LOAD sE, 3C                     ; 0D4 00E3C
    JUMP sdc_write_zero_reg         ; 0D5 340DE

; ---- sdc_bus_4bit ---- called from 02C
sdc_bus_4bit:
    LOAD sE, 1C                     ; 0D6 00E1C
    CALL sdc_zero_upper             ; 0D7 300E2
L_0D8:
    LOAD s1, 01                     ; 0D8 00101
    OUTPUT s1, SDC_D0               ; 0D9 2C170
    CALL sdc_write_reg              ; 0DA 3015A
    RETURN                          ; 0DB 2A000

; ---- sdc_bus_1bit ---- called from 0AF
sdc_bus_1bit:
    LOAD sE, 1C                     ; 0DC 00E1C
    JUMP sdc_write_zero_reg         ; 0DD 340DE
sdc_write_zero_reg:
    CALL sdc_zero_upper             ; 0DE 300E2
    OUTPUT sD, SDC_D0               ; 0DF 2CD70
    CALL sdc_write_reg              ; 0E0 3015A
    RETURN                          ; 0E1 2A000

; ---- sdc_zero_upper ---- called from 0B6, 0C4, 0D0, 0D7, 0DE, 114
sdc_zero_upper:
    LOAD sD, 00                     ; 0E2 00D00
    OUTPUT sD, SDC_D3               ; 0E3 2CD73
    OUTPUT sD, SDC_D2               ; 0E4 2CD72
    OUTPUT sD, SDC_D1               ; 0E5 2CD71
    RETURN                          ; 0E6 2A000

; Send an SD command through the controller.
; sC = command index, sB = response flags (b0 response, b1 136-bit,
; b2 CRC check, b3 busy, b4 index check), sA:s9:s8:s7 = argument,
; xfer_dir = 0 none / 1 read / 2 write. Waits for completion.

; ---- sd_command ---- called from 08A, 0A5, 1A1
sd_command:
    LOAD s0, 00                     ; 0E7 00000
    TEST sB, 01                     ; 0E8 12B01
    JUMP Z, L_0EF                   ; 0E9 350EF
    TEST sB, 02                     ; 0EA 12B02
    JUMP Z, L_0EE                   ; 0EB 350EE
    OR s0, 02                       ; 0EC 0C002
    JUMP L_0EF                      ; 0ED 340EF
L_0EE:
    OR s0, 01                       ; 0EE 0C001
L_0EF:
    TEST sB, 08                     ; 0EF 12B08
    JUMP Z, L_0F2                   ; 0F0 350F2
    OR s0, 04                       ; 0F1 0C004
L_0F2:
    TEST sB, 04                     ; 0F2 12B04
    JUMP Z, L_0F5                   ; 0F3 350F5
    OR s0, 08                       ; 0F4 0C008
L_0F5:
    TEST sB, 10                     ; 0F5 12B10
    JUMP Z, L_0F8                   ; 0F6 350F8
    OR s0, 10                       ; 0F7 0C010
L_0F8:
    FETCH s1, xfer_dir              ; 0F8 06119  data transfer? set DMA address, block size, count first
    COMPARE s1, 01                  ; 0F9 14101
    JUMP NZ, L_0FD                  ; 0FA 354FD
    OR s0, 20                       ; 0FB 0C020
    JUMP L_100                      ; 0FC 34100
L_0FD:
    COMPARE s1, 02                  ; 0FD 14102
    JUMP NZ, L_118                  ; 0FE 35518
    OR s0, 40                       ; 0FF 0C040
L_100:
    LOAD sE, 60                     ; 100 00E60  reg $60 DMA address
    FETCH s1, dma_addr3             ; 101 0611A
    OUTPUT s1, SDC_D3               ; 102 2C173
    FETCH s1, dma_addr2             ; 103 0611B
    OUTPUT s1, SDC_D2               ; 104 2C172
    FETCH s1, dma_addr1             ; 105 0611C
    OUTPUT s1, SDC_D1               ; 106 2C171
    FETCH s1, dma_addr0             ; 107 0611D
    OUTPUT s1, SDC_D0               ; 108 2C170
    CALL sdc_write_reg              ; 109 3015A
    LOAD sE, 44                     ; 10A 00E44  reg $44 block size - 1
    LOAD s1, 00                     ; 10B 00100
    OUTPUT s1, SDC_D3               ; 10C 2C173
    OUTPUT s1, SDC_D2               ; 10D 2C172
    FETCH s1, blksize_hi            ; 10E 0611E
    OUTPUT s1, SDC_D1               ; 10F 2C171
    FETCH s1, blksize_lo            ; 110 0611F
    OUTPUT s1, SDC_D0               ; 111 2C170
    CALL sdc_write_reg              ; 112 3015A
    LOAD sE, 48                     ; 113 00E48  reg $48 block count - 1
    CALL sdc_zero_upper             ; 114 300E2
    FETCH s1, blkcount_m1           ; 115 06120
    OUTPUT s1, SDC_D0               ; 116 2C170
    CALL sdc_write_reg              ; 117 3015A
L_118:
    LOAD sE, 04                     ; 118 00E04  reg $04 command word
    OUTPUT sC, SDC_D1               ; 119 2CC71
    OUTPUT s0, SDC_D0               ; 11A 2C070
    CALL sdc_write_reg              ; 11B 3015A
    LOAD sE, 00                     ; 11C 00E00  reg $00 argument (starts the command)
    OUTPUT sA, SDC_D3               ; 11D 2CA73
    OUTPUT s9, SDC_D2               ; 11E 2C972
    OUTPUT s8, SDC_D1               ; 11F 2C871
    OUTPUT s7, SDC_D0               ; 120 2C770
    CALL sdc_write_reg              ; 121 3015A
L_122:
    LOAD sE, 34                     ; 122 00E34  reg $34 command event status
    CALL sdc_wait_ack               ; 123 3015C
    INPUT s0, SDC_Q0                ; 124 04070
    COMPARE s0, 06                  ; 125 14006
    JUMP Z, L_129                   ; 126 35129
    TEST s0, 01                     ; 127 12001
    JUMP Z, L_122                   ; 128 35122
L_129:
    LOAD sE, 34                     ; 129 00E34
    LOAD sD, 00                     ; 12A 00D00
    OUTPUT sD, SDC_D0               ; 12B 2CD70
    CALL sdc_write_reg              ; 12C 3015A
    FETCH s1, xfer_dir              ; 12D 06119
    COMPARE s1, 00                  ; 12E 14100
    JUMP Z, L_13E                   ; 12F 3513E
    LOAD sF, 55                     ; 130 00F55  debug 55: waiting for data
    CALL dbg_putc                   ; 131 30155
L_132:
    LOAD sE, 3C                     ; 132 00E3C  reg $3C data event status
    CALL sdc_wait_ack               ; 133 3015C
    INPUT s3, SDC_Q0                ; 134 04370
    TEST s3, 01                     ; 135 12301
    JUMP Z, L_132                   ; 136 35132
    STORE s3, data_status           ; 137 2E33D
    LOAD sE, 3C                     ; 138 00E3C
    LOAD sD, 00                     ; 139 00D00
    OUTPUT sD, SDC_D0               ; 13A 2CD70
    CALL sdc_write_reg              ; 13B 3015A
    LOAD s1, 00                     ; 13C 00100
    STORE s1, xfer_dir              ; 13D 2E119
L_13E:
    RETURN                          ; 13E 2A000

; ---- sdc_read_response ---- called from 010, 01E, 05C, 14B, 38E
sdc_read_response:
    LOAD sE, 08                     ; 13F 00E08
    JUMP L_141                      ; 140 34141
L_141:
    CALL sdc_wait_ack               ; 141 3015C
    INPUT s6, SDC_Q3                ; 142 04673
    STORE s6, resp0                 ; 143 2E602
    INPUT s5, SDC_Q2                ; 144 04572
    STORE s5, resp1                 ; 145 2E503
    INPUT s4, SDC_Q1                ; 146 04471
    STORE s4, resp2                 ; 147 2E404
    INPUT s3, SDC_Q0                ; 148 04370
    STORE s3, resp3                 ; 149 2E305
    RETURN                          ; 14A 2A000

; ---- save_cid ---- called from 01A
save_cid:
    CALL sdc_read_response          ; 14B 3013F
    FETCH s0, resp3                 ; 14C 06005
    STORE s0, cid3                  ; 14D 2E016
    FETCH s0, resp2                 ; 14E 06004
    STORE s0, cid2                  ; 14F 2E015
    FETCH s0, resp1                 ; 150 06003
    STORE s0, cid1                  ; 151 2E014
    FETCH s0, resp0                 ; 152 06002
    STORE s0, cid0                  ; 153 2E013
