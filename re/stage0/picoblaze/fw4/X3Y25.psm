L_07A:
    CALL delay_long                 ; 07A 30074
    SUB s4, 01                      ; 07B 1C401
    JUMP NZ, L_07A                  ; 07C 3547A
    RETURN                          ; 07D 2A000

; SPI flash. SPI_CTRL bit 0 = SCK, bit 1 = CS_B (spi_shadow keeps
; the last value); SPI_MOSI bit 7 = MOSI; SPI_MISO bit 7 = MISO.
spi_cmd_tail:
    CALL spi_xfer                   ; 07E 300AE
    XOR s0, 02                      ; 07F 0E002
    OUTPUT s0, SPI_CTRL             ; 080 2C0D4
    STORE s0, spi_shadow            ; 081 2E01D
    RETURN                          ; 082 2A000
; $083-$097: unreached words, kept as data
ADDRESS 083
    ; dead_spi_cmds:
    ; 083: 300AA  CALL spi_deselect
    DATA_WORD 300AA
    ; 084: 0E002  XOR s0, 02
    DATA_WORD 0E002
    ; 085: 2C0D4  OUTPUT s0, SPI_CTRL
    DATA_WORD 2C0D4
    ; 086: 2E01D  STORE s0, spi_shadow
    DATA_WORD 2E01D
    ; 087: 012A0  LOAD s2, sA
    DATA_WORD 012A0
    ; 088: 3407E  JUMP spi_cmd_tail
    DATA_WORD 3407E
    ; 089: 00AAB  LOAD sA, AB               unreached: $AB release from power-down, $50 EWSR
    DATA_WORD 00AAB
    ; 08A: 30083  CALL dead_spi_cmds
    DATA_WORD 30083
    ; 08B: 00A50  LOAD sA, 50
    DATA_WORD 00A50
    ; 08C: 30083  CALL dead_spi_cmds
    DATA_WORD 30083
    ; 08D: 300AA  CALL spi_deselect
    DATA_WORD 300AA
    ; 08E: 0E002  XOR s0, 02
    DATA_WORD 0E002
    ; 08F: 2C0D4  OUTPUT s0, SPI_CTRL
    DATA_WORD 2C0D4
    ; 090: 2E01D  STORE s0, spi_shadow
    DATA_WORD 2E01D
    ; 091: 00201  LOAD s2, 01
    DATA_WORD 00201
    ; 092: 300AE  CALL spi_xfer
    DATA_WORD 300AE
    ; 093: 00200  LOAD s2, 00
    DATA_WORD 00200
    ; 094: 300AE  CALL spi_xfer
    DATA_WORD 300AE
    ; 095: 00200  LOAD s2, 00
    DATA_WORD 00200
    ; 096: 3007E  CALL spi_cmd_tail
    DATA_WORD 3007E
    ; 097: 2A000  RETURN
    DATA_WORD 2A000

; ---- flash_read_record ---- called from 206
flash_read_record:
    LOAD s7, 7E                     ; 098 0077E  read 126 bytes from flash_a2:a1:a0 into $1E.. (first 33 kept),
    LOAD s6, 00                     ; 099 00600
    LOAD s4, 1E                     ; 09A 0041E
    CALL spi_read_start             ; 09B 300D9
L_09C:
    CALL spi_xfer                   ; 09C 300AE
    ADD s6, s2                      ; 09D 19620  running byte sum
    COMPARE s4, 3F                  ; 09E 1443F
    JUMP C, L_0A1                   ; 09F 358A1
    JUMP L_0A3                      ; 0A0 340A3
L_0A1:
    STORE s2, (s4)                  ; 0A1 2F240
    ADD s4, 01                      ; 0A2 18401
L_0A3:
    SUB s7, 01                      ; 0A3 1C701
    JUMP NZ, L_09C                  ; 0A4 3549C
    CALL spi_xfer                   ; 0A5 300AE
    XOR s6, s2                      ; 0A6 0F620  compare the sum with the record's own check byte
    CALL spi_xfer                   ; 0A7 300AE
    CALL spi_cs_toggle              ; 0A8 300E6
    RETURN                          ; 0A9 2A000

; ---- spi_deselect ---- called from 0BC, 0C3, 0D9, 0EC, 100, 1FA
spi_deselect:
    LOAD s0, AF                     ; 0AA 000AF
    OUTPUT s0, SPI_CTRL             ; 0AB 2C0D4
    STORE s0, spi_shadow            ; 0AC 2E01D
    RETURN                          ; 0AD 2A000

; ---- spi_xfer ---- called from 07E, 09C, 0A5, 0A7, 0C1, 0DE, 0E0, 0E2, 0E4, 0F1, 0F3, 0F5, 0F7, 105, 107, 109, 10B, 155, 1C7, 1CF, 1D8, 1DE, 1E1, 1EA, 246, 248, 24A, 24C
spi_xfer:
    LOAD s1, 08                     ; 0AE 00108  8 bits MSB first: s2 out, s2 in
    FETCH s0, spi_shadow            ; 0AF 0601D
L_0B0:
    OUTPUT s2, SPI_MOSI             ; 0B0 2C2D5
    XOR s0, 01                      ; 0B1 0E001
    OUTPUT s0, SPI_CTRL             ; 0B2 2C0D4
    LOAD s0, s0                     ; 0B3 01000
    INPUT s3, SPI_MISO              ; 0B4 043D4
    TEST s3, 80                     ; 0B5 12380
    SLA s2                          ; 0B6 20200
    XOR s0, 01                      ; 0B7 0E001
    OUTPUT s0, SPI_CTRL             ; 0B8 2C0D4
    SUB s1, 01                      ; 0B9 1C101
    JUMP NZ, L_0B0                  ; 0BA 354B0
    RETURN                          ; 0BB 2A000

; ---- spi_rdsr ---- called from 0FB, 111
spi_rdsr:
    CALL spi_deselect               ; 0BC 300AA
    XOR s0, 02                      ; 0BD 0E002
    OUTPUT s0, SPI_CTRL             ; 0BE 2C0D4
    STORE s0, spi_shadow            ; 0BF 2E01D
    LOAD s2, 05                     ; 0C0 00205  $05 READ STATUS
    CALL spi_xfer                   ; 0C1 300AE
    JUMP spi_cmd_tail               ; 0C2 3407E

; ---- spi_wren ---- called from 0EB, 0FF
spi_wren:
    CALL spi_deselect               ; 0C3 300AA
    XOR s0, 02                      ; 0C4 0E002
    OUTPUT s0, SPI_CTRL             ; 0C5 2C0D4
    STORE s0, spi_shadow            ; 0C6 2E01D
    LOAD s2, 06                     ; 0C7 00206  $06 WRITE ENABLE
    JUMP spi_cmd_tail               ; 0C8 3407E
; $0C9-$0D8: unreached words, kept as data
ADDRESS 0C9
