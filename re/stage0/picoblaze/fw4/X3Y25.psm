    CALL spi_xfer                   ; 0DE 300AE
    LOAD s2, sC                     ; 0DF 012C0
    CALL spi_xfer                   ; 0E0 300AE
    LOAD s2, sB                     ; 0E1 012B0
    CALL spi_xfer                   ; 0E2 300AE
    LOAD s2, sA                     ; 0E3 012A0
    CALL spi_xfer                   ; 0E4 300AE
    RETURN                          ; 0E5 2A000

