; MultiBoot reboot through ICAP: sync AA99, GENERAL1/2 = next
; image address (mb_addr), CMD = IPROG ($000E). Used by the slot A
; image to hand over to slot B.

; ---- icap_reboot ---- called from 1F3
icap_reboot:
    CALL icap_select                ; 115 30145
    LOAD s3, AA                     ; 116 003AA  sync AA 99
    CALL icap_write                 ; 117 3014D
    LOAD s3, 99                     ; 118 00399
    CALL icap_write                 ; 119 3014D
    LOAD s3, 32                     ; 11A 00332  GENERAL1 = mb_addr_mid:mb_addr_lo
    CALL icap_write                 ; 11B 3014D
    LOAD s3, 61                     ; 11C 00361
    CALL icap_write                 ; 11D 3014D
    FETCH s3, mb_addr_mid           ; 11E 06301
    CALL icap_write                 ; 11F 3014D
    FETCH s3, mb_addr_lo            ; 120 06300
    CALL icap_write                 ; 121 3014D
    LOAD s3, 32                     ; 122 00332  GENERAL2 = $03 (read opcode) : mb_addr_hi
    CALL icap_write                 ; 123 3014D
    LOAD s3, 81                     ; 124 00381
    CALL icap_write                 ; 125 3014D
    LOAD s3, 03                     ; 126 00303
    CALL icap_write                 ; 127 3014D
    FETCH s3, mb_addr_hi            ; 128 06302
    CALL icap_write                 ; 129 3014D
    LOAD s3, 32                     ; 12A 00332  MODE
    CALL icap_write                 ; 12B 3014D
    LOAD s3, A1                     ; 12C 003A1
    CALL icap_write                 ; 12D 3014D
    LOAD s3, 00                     ; 12E 00300
    CALL icap_write                 ; 12F 3014D
    LOAD s3, 4F                     ; 130 0034F
    CALL icap_write                 ; 131 3014D
    LOAD s3, 30                     ; 132 00330  CMD = IPROG
    CALL icap_write                 ; 133 3014D
    LOAD s3, A1                     ; 134 003A1
    CALL icap_write                 ; 135 3014D
    LOAD s3, 00                     ; 136 00300
    CALL icap_write                 ; 137 3014D
    LOAD s3, 0E                     ; 138 0030E
    CALL icap_write                 ; 139 3014D
    LOAD s3, 20                     ; 13A 00320
    CALL icap_write                 ; 13B 3014D
    LOAD s3, 00                     ; 13C 00300
    CALL icap_write                 ; 13D 3014D
    CALL icap_idle                  ; 13E 30140
    RETURN                          ; 13F 2A000

; ---- icap_idle ---- called from 13E, 1F2
icap_idle:
    LOAD s0, 06                     ; 140 00006  ICAP_CTRL bit 0 = CLK, bits 1-2 = CE_B / WRITE_B
    OUTPUT s0, ICAP_CTRL            ; 141 2C0D2
    CALL icap_clock                 ; 142 30148
    CALL icap_clock                 ; 143 30148
    RETURN                          ; 144 2A000

; ---- icap_select ---- called from 115
icap_select:
    LOAD s0, 00                     ; 145 00000
    OUTPUT s0, ICAP_CTRL            ; 146 2C0D2
    RETURN                          ; 147 2A000

; ---- icap_clock ---- called from 142, 143, 14E
icap_clock:
    XOR s0, 01                      ; 148 0E001
    OUTPUT s0, ICAP_CTRL            ; 149 2C0D2
    XOR s0, 01                      ; 14A 0E001
    OUTPUT s0, ICAP_CTRL            ; 14B 2C0D2
    RETURN                          ; 14C 2A000

; ---- icap_write ---- called from 117, 119, 11B, 11D, 11F, 121, 123, 125, 127, 129, 12B, 12D, 12F, 131, 133, 135, 137, 139, 13B, 13D
icap_write:
    OUTPUT s3, ICAP_DATA            ; 14D 2C3D1
    CALL icap_clock                 ; 14E 30148
    RETURN                          ; 14F 2A000

; Boot tally at flash $070000: find the first non-zero byte.
; If all 256 are zero, erase the sector and start over.
; Byte states: FF unused, 01 slot A handed over to slot B,
; 00 slot B booted. A 01 at boot means slot B failed last time.

; ---- tally_find ---- called from 1BB, 1BE
tally_find:
    LOAD sC, 07                     ; 150 00C07
    LOAD sB, 00                     ; 151 00B00
    LOAD sA, 00                     ; 152 00A00
    LOAD s6, 00                     ; 153 00600
L_154:
    CALL spi_read_start             ; 154 300D9
    CALL spi_xfer                   ; 155 300AE
    CALL spi_cs_toggle              ; 156 300E6
    COMPARE s2, 00                  ; 157 14200
