; License check. The record at flash $031100 holds the expected
; CRCs; both CRCs are computed over the record bytes with the
; chip's Device DNA mixed in. Pass sets verdict_a/b = F1 / F2.

; ---- license_check ---- called from 213
license_check:
    FETCH s7, dna0                  ; 17C 0670A  DNA (reversed) -> $32-$39
    STORE s7, 39                    ; 17D 2E739
    FETCH s7, dna1                  ; 17E 0670B
    STORE s7, 38                    ; 17F 2E738
    FETCH s7, dna2                  ; 180 0670C
    STORE s7, 37                    ; 181 2E737
    FETCH s7, dna3                  ; 182 0670D
    STORE s7, 36                    ; 183 2E736
    FETCH s7, dna4                  ; 184 0670E
    STORE s7, 35                    ; 185 2E735
    FETCH s7, dna5                  ; 186 0670F
    STORE s7, 34                    ; 187 2E734
    FETCH s7, dna6                  ; 188 06710
    STORE s7, 33                    ; 189 2E733
    FETCH s7, dna7                  ; 18A 06711
    STORE s7, 32                    ; 18B 2E732
    LOAD s4, 1E                     ; 18C 0041E
    LOAD s5, 1C                     ; 18D 0051C
    CALL crc16                      ; 18E 30031  CRC-16 over $1E-$39
    FETCH s5, want_crc16_hi         ; 18F 06517
    FETCH s4, want_crc16_lo         ; 190 06418
    COMPARE s7, s5                  ; 191 15750  vs want_crc16
    JUMP NZ, L_195                  ; 192 35595
    COMPARE s6, s4                  ; 193 15640
    CALL Z, verdict_a_ok            ; 194 3105B
L_195:
    FETCH s7, dna0                  ; 195 0670A  DNA -> $28-$2F
    STORE s7, 2F                    ; 196 2E72F
    FETCH s7, dna1                  ; 197 0670B
    STORE s7, 2E                    ; 198 2E72E
    FETCH s7, dna2                  ; 199 0670C
    STORE s7, 2D                    ; 19A 2E72D
    FETCH s7, dna3                  ; 19B 0670D
    STORE s7, 2C                    ; 19C 2E72C
    FETCH s7, dna4                  ; 19D 0670E
    STORE s7, 2B                    ; 19E 2E72B
    FETCH s7, dna5                  ; 19F 0670F
    STORE s7, 2A                    ; 1A0 2E72A
    FETCH s7, dna6                  ; 1A1 06710
    STORE s7, 29                    ; 1A2 2E729
    FETCH s7, dna7                  ; 1A3 06711
    STORE s7, 28                    ; 1A4 2E728
    LOAD s0, 1E                     ; 1A5 0001E
    LOAD s4, 12                     ; 1A6 00412
    CALL crc7                       ; 1A7 30043  CRC-7 over $1E-$2F
    FETCH s0, want_crc7             ; 1A8 06016
    COMPARE s0, sF                  ; 1A9 150F0  vs want_crc7
    CALL Z, verdict_b_ok            ; 1AA 3105E
    RETURN                          ; 1AB 2A000

; ---- clear_scratchpad ---- called from 225
clear_scratchpad:
    LOAD s6, 00                     ; 1AC 00600
    LOAD s4, 00                     ; 1AD 00400
L_1AE:
    COMPARE s4, 3E                  ; 1AE 1443E
    JUMP C, L_1B1                   ; 1AF 359B1
    JUMP L_1B4                      ; 1B0 341B4
L_1B1:
    STORE s6, (s4)                  ; 1B1 2F640
    ADD s4, 01                      ; 1B2 18401
    JUMP L_1AE                      ; 1B3 341AE
L_1B4:
