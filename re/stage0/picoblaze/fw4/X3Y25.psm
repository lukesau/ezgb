; Bank 2 main, called from bank 1 with license_b = 0 (boot) or
; 1 (flash update, kernel command $08). Boot: fail-safe MultiBoot.
; The slot A image (the fallback image, at 0) hands over to slot B when the
; tally byte is clean and slot B looks valid; slot B just marks
; the byte done. Then both run the license scan.

; ---- bank2_main ---- called from 3F3
bank2_main:
    FETCH s2, license_b             ; 1B5 0623F
    COMPARE s2, 01                  ; 1B6 14201
    JUMP Z, flash_update            ; 1B7 3522F  flash update requested
    LOAD s0, 02                     ; 1B8 00002  slot A image: 01 (hand over to slot B); slot B image: 02 (never)
    COMPARE s0, 01                  ; 1B9 14001
    JUMP Z, multiboot_check         ; 1BA 351BD
    CALL tally_find                 ; 1BB 30150
    JUMP tally_advance              ; 1BC 341C2
multiboot_check:
    CALL delay_huge                 ; 1BD 30079
    CALL tally_find                 ; 1BE 30150
    FETCH s0, tally_byte            ; 1BF 06012
    COMPARE s0, FF                  ; 1C0 140FF  FF: clean, try slot B. 01: slot B failed last boot, stay here
    JUMP Z, find_slot_b             ; 1C1 351CA
tally_advance:
    LOAD sC, 07                     ; 1C2 00C07
    LOAD sB, 00                     ; 1C3 00B00
    FETCH sA, tally_index           ; 1C4 06A13
    CALL flash_page_program_start   ; 1C5 300FF
    LOAD s2, 00                     ; 1C6 00200  tally byte = 00
    CALL spi_xfer                   ; 1C7 300AE
    CALL flash_wait_done            ; 1C8 3010D
    JUMP license_scan               ; 1C9 341F8
find_slot_b:
    LOAD sC, 04                     ; 1CA 00C04  look for a bitstream sync (AA 99 .. 31 61) at $040000
    LOAD sB, 00                     ; 1CB 00B00
    LOAD sA, 00                     ; 1CC 00A00
    LOAD s6, 00                     ; 1CD 00600
    CALL spi_read_start             ; 1CE 300D9
L_1CF:
    CALL spi_xfer                   ; 1CF 300AE
    COMPARE s2, FF                  ; 1D0 142FF
    JUMP NZ, L_1D6                  ; 1D1 355D6
    ADD s6, 01                      ; 1D2 18601
    COMPARE s6, E0                  ; 1D3 146E0
    JUMP Z, slot_b_bad              ; 1D4 351F4
    JUMP L_1CF                      ; 1D5 341CF
L_1D6:
    COMPARE s2, AA                  ; 1D6 142AA
    JUMP NZ, slot_b_bad             ; 1D7 355F4
    CALL spi_xfer                   ; 1D8 300AE
    COMPARE s2, 99                  ; 1D9 14299
    JUMP NZ, slot_b_bad             ; 1DA 355F4
L_1DB:
    ADD s6, 01                      ; 1DB 18601
    COMPARE s6, F8                  ; 1DC 146F8
    JUMP Z, slot_b_bad              ; 1DD 351F4
    CALL spi_xfer                   ; 1DE 300AE
    COMPARE s2, 31                  ; 1DF 14231
    JUMP NZ, L_1DB                  ; 1E0 355DB
    CALL spi_xfer                   ; 1E1 300AE
    COMPARE s2, 61                  ; 1E2 14261
    JUMP NZ, L_1DB                  ; 1E3 355DB
    CALL spi_cs_toggle              ; 1E4 300E6
    LOAD sC, 07                     ; 1E5 00C07
    LOAD sB, 00                     ; 1E6 00B00
    FETCH sA, tally_index           ; 1E7 06A13
    CALL flash_page_program_start   ; 1E8 300FF
    LOAD s2, 01                     ; 1E9 00201  tally byte = 01: hand-over in progress
    CALL spi_xfer                   ; 1EA 300AE
    CALL flash_wait_done            ; 1EB 3010D
    LOAD s1, 04                     ; 1EC 00104
    STORE s1, mb_addr_hi            ; 1ED 2E102
    LOAD s1, 00                     ; 1EE 00100
    STORE s1, mb_addr_mid           ; 1EF 2E101
    LOAD s1, 00                     ; 1F0 00100
    STORE s1, mb_addr_lo            ; 1F1 2E100
    CALL icap_idle                  ; 1F2 30140
    CALL icap_reboot                ; 1F3 30115
slot_b_bad:
    CALL spi_cs_toggle              ; 1F4 300E6
    LOAD sE, 44                     ; 1F5 00E44  debug 44: slot B invalid, boot slot A
    CALL dbg_putc                   ; 1F6 30061
    JUMP tally_advance              ; 1F7 341C2
license_scan:
    CALL dna_idle                   ; 1F8 30003
    CALL dna_read                   ; 1F9 30006  read Device DNA
    CALL spi_deselect               ; 1FA 300AA
    LOAD s0, 03                     ; 1FB 00003  records at $030000, 128 bytes each
    STORE s0, flash_a2              ; 1FC 2E005
    LOAD s0, 00                     ; 1FD 00000
    STORE s0, flash_a1              ; 1FE 2E004
    LOAD s0, 00                     ; 1FF 00000
    STORE s0, flash_a0              ; 200 2E003
L_201:
    FETCH sC, flash_a2              ; 201 06C05
    FETCH sB, flash_a1              ; 202 06B04
    FETCH sA, flash_a0              ; 203 06A03
    COMPARE sB, 15                  ; 204 14B15  stop at $031500
    JUMP Z, license_done            ; 205 3521E
    CALL flash_read_record          ; 206 30098
    COMPARE s2, s6                  ; 207 15260
    CALL NZ, record_bad             ; 208 31579  bad record checksum -> record_error = EE
    COMPARE sB, 11                  ; 209 14B11  the record at $031100 carries the license CRCs
    JUMP NZ, L_214                  ; 20A 35614
    COMPARE sA, 00                  ; 20B 14A00
    JUMP NZ, L_214                  ; 20C 35614
    FETCH s0, 28                    ; 20D 06028
    STORE s0, want_crc7             ; 20E 2E016
    FETCH s0, 32                    ; 20F 06032
    STORE s0, want_crc16_hi         ; 210 2E017
    FETCH s0, 33                    ; 211 06033
    STORE s0, want_crc16_lo         ; 212 2E018
    CALL license_check              ; 213 3017C
L_214:
    FETCH sC, flash_a2              ; 214 06C05
    FETCH sB, flash_a1              ; 215 06B04
    FETCH sA, flash_a0              ; 216 06A03
    ADD sA, 80                      ; 217 18A80
    ADDCY sB, 00                    ; 218 1AB00
    ADDCY sC, 00                    ; 219 1AC00
    STORE sC, flash_a2              ; 21A 2EC05
    STORE sB, flash_a1              ; 21B 2EB04
    STORE sA, flash_a0              ; 21C 2EA03
    JUMP L_201                      ; 21D 34201
license_done:
    FETCH s0, record_error          ; 21E 06006
    COMPARE s0, EE                  ; 21F 140EE
    JUMP Z, L_226                   ; 220 35226
    FETCH s0, verdict_a             ; 221 06019  publish verdict for bank 1, unless any record was bad
    STORE s0, license_a             ; 222 2E03E
    FETCH s0, verdict_b             ; 223 0601A
    STORE s0, license_b             ; 224 2E03F
    CALL clear_scratchpad           ; 225 301AC
L_226:
    RETURN                          ; 226 2A000

; Read one 32-bit table entry: index s5 -> s3:s2:s1:s0.

; ---- tbl_read ---- called from 232, 241
tbl_read:
    OUTPUT s5, TBL_INDEX            ; 227 2C5BF
    LOAD s1, s1                     ; 228 01110
    LOAD s1, s1                     ; 229 01110
    INPUT s3, TBL_Q3                ; 22A 043C0
    INPUT s2, TBL_Q2                ; 22B 042C1
    INPUT s1, TBL_Q1                ; 22C 041C2
    INPUT s0, TBL_Q0                ; 22D 040C3
    RETURN                          ; 22E 2A000

; Flash update (kernel command $08). Table entry 0 = flash
; address; entries 1-$40 = 256 bytes of data. Erases the 64 KB
; sector when the address is on a sector boundary, then programs
; one 256-byte page.
flash_update:
    LOAD s2, 01                     ; 22F 00201
    OUTPUT s2, FLASH_BUSY           ; 230 2C2F1  FLASH_BUSY on
    LOAD s5, 00                     ; 231 00500
    CALL tbl_read                   ; 232 30227
    STORE s2, flash_a2              ; 233 2E205
    STORE s1, flash_a1              ; 234 2E104
    STORE s0, flash_a0              ; 235 2E003
    COMPARE s1, 00                  ; 236 14100  address bits 15:8 == 0: start of a sector, erase it
    JUMP NZ, L_23C                  ; 237 3563C
    LOAD sC, s2                     ; 238 01C20
    LOAD sB, s1                     ; 239 01B10
    LOAD sA, s0                     ; 23A 01A00
    CALL flash_sector_erase         ; 23B 300EB
L_23C:
    FETCH sC, flash_a2              ; 23C 06C05
    FETCH sB, flash_a1              ; 23D 06B04
    FETCH sA, flash_a0              ; 23E 06A03
    CALL flash_page_program_start   ; 23F 300FF  page program at the address
    LOAD s5, 01                     ; 240 00501
L_241:
    CALL tbl_read                   ; 241 30227
    STORE s3, dna3                  ; 242 2E30D
    STORE s2, dna2                  ; 243 2E20C
    STORE s1, dna1                  ; 244 2E10B
    LOAD s2, s0                     ; 245 01200
    CALL spi_xfer                   ; 246 300AE
    FETCH s2, dna1                  ; 247 0620B
    CALL spi_xfer                   ; 248 300AE
    FETCH s2, dna2                  ; 249 0620C
    CALL spi_xfer                   ; 24A 300AE
    FETCH s2, dna3                  ; 24B 0620D
    CALL spi_xfer                   ; 24C 300AE
    ADD s5, 01                      ; 24D 18501
    COMPARE s5, 41                  ; 24E 14541
    JUMP NZ, L_241                  ; 24F 35641
    CALL flash_wait_done            ; 250 3010D
    LOAD s2, 00                     ; 251 00200
    OUTPUT s2, FLASH_BUSY           ; 252 2C2F1  FLASH_BUSY off
    RETURN                          ; 253 2A000
; $254-$3EF: 412 unused (zero) words
ADDRESS 3F0

; Bank switch window (identical in bank 1 except $3F3).

; ---- bank2_entry ---- extra entry: no path from reset or interrupt reaches here
bank2_entry:
    LOAD s0, 01                     ; 3F0 00001
    OUTPUT s0, BANK_SELECT          ; 3F1 2C0C8
    LOAD s0, s0                     ; 3F2 01000
    CALL bank2_main                 ; 3F3 301B5  the only instruction bank 1 runs from bank 2
    LOAD s0, 00                     ; 3F4 00000
    OUTPUT s0, BANK_SELECT          ; 3F5 2C0C8
    LOAD s0, s0                     ; 3F6 01000
    RETURN                          ; 3F7 2A000
