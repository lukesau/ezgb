; ---- dbg_putc ---- called from 177, 1F6
dbg_putc:
    INPUT s0, DBG_STATUS            ; 061 040A0
    TEST s0, 04                     ; 062 12004
    JUMP NZ, dbg_putc               ; 063 35461
    OUTPUT sE, DBG_TX               ; 064 2CEA1
    RETURN                          ; 065 2A000

; ---- delay_tiny ---- called from 06B
delay_tiny:
    LOAD s0, 0B                     ; 066 0000B
L_067:
    SUB s0, 01                      ; 067 1C001
    JUMP NZ, L_067                  ; 068 35467
