; D0X3Y25.BEL.BRAM
; KCPSM3 (PicoBlaze for Spartan-3), 1K x 18
; 551 reachable instructions, 35 subroutines
;
CONSTANT DBG_STATUS, A0   ; input port
CONSTANT TBL_Q3, C0   ; input port
CONSTANT TBL_Q2, C1   ; input port
CONSTANT TBL_Q1, C2   ; input port
CONSTANT TBL_Q0, C3   ; input port
CONSTANT DNA_DOUT, D3   ; input port
CONSTANT SPI_MISO, D4   ; input port
CONSTANT DBG_TX, A1   ; output port
CONSTANT TBL_INDEX, BF   ; output port
CONSTANT BANK_SELECT, C8   ; output port
CONSTANT ICAP_DATA, D1   ; output port
CONSTANT ICAP_CTRL, D2   ; output port
CONSTANT DNA_CTRL, D3   ; output port
CONSTANT SPI_CTRL, D4   ; output port
CONSTANT SPI_MOSI, D5   ; output port
CONSTANT FLASH_BUSY, F1   ; output port
CONSTANT mb_addr_lo, 00   ; scratchpad
CONSTANT mb_addr_mid, 01   ; scratchpad
CONSTANT mb_addr_hi, 02   ; scratchpad
CONSTANT flash_a0, 03   ; scratchpad
CONSTANT flash_a1, 04   ; scratchpad
CONSTANT flash_a2, 05   ; scratchpad
CONSTANT record_error, 06   ; scratchpad
CONSTANT dna0, 0A   ; scratchpad
CONSTANT dna1, 0B   ; scratchpad
CONSTANT dna2, 0C   ; scratchpad
CONSTANT dna3, 0D   ; scratchpad
CONSTANT dna4, 0E   ; scratchpad
CONSTANT dna5, 0F   ; scratchpad
CONSTANT dna6, 10   ; scratchpad
CONSTANT dna7, 11   ; scratchpad
CONSTANT tally_byte, 12   ; scratchpad
CONSTANT tally_index, 13   ; scratchpad
CONSTANT want_crc7, 16   ; scratchpad
CONSTANT want_crc16_hi, 17   ; scratchpad
CONSTANT want_crc16_lo, 18   ; scratchpad
CONSTANT verdict_a, 19   ; scratchpad
CONSTANT verdict_b, 1A   ; scratchpad
CONSTANT spi_shadow, 1D   ; scratchpad
CONSTANT license_a, 3E   ; scratchpad
CONSTANT license_b, 3F   ; scratchpad


; Bank 2 reset path: never used (the processor always resets in
; bank 1). A long delay loop with interrupts off.
bank2_reset_unused:
    DISABLE INTERRUPT               ; 000 3C000
L_001:
    CALL delay_huge                 ; 001 30079
    JUMP L_001                      ; 002 34001

; Device DNA (Spartan-3A DNA_PORT). DNA_CTRL bit 0 = CLK,
; bit 1 = SHIFT, bit 2 = READ; DNA_DOUT bit 0 = DOUT.

; ---- dna_idle ---- called from 1F8
dna_idle:
    LOAD s0, 00                     ; 003 00000
    OUTPUT s0, DNA_CTRL             ; 004 2C0D3
    RETURN                          ; 005 2A000

; ---- dna_read ---- called from 1F9
dna_read:
    LOAD s0, 04                     ; 006 00004  READ: latch the 57-bit DNA
    OUTPUT s0, DNA_CTRL             ; 007 2C0D3
    CALL dna_clock                  ; 008 30024
    LOAD s0, 02                     ; 009 00002
    OUTPUT s0, DNA_CTRL             ; 00A 2C0D3
    LOAD s3, 00                     ; 00B 00300
    LOAD s2, 39                     ; 00C 00239  57 bits
L_00D:
    INPUT s1, DNA_DOUT              ; 00D 041D3
    TEST s1, 01                     ; 00E 12101
    SLA s3                          ; 00F 20300
    SLA s4                          ; 010 20400
    SLA s5                          ; 011 20500
    SLA s6                          ; 012 20600
    SLA s7                          ; 013 20700
    SLA s8                          ; 014 20800
    SLA s9                          ; 015 20900
    SLA sA                          ; 016 20A00
    CALL dna_clock                  ; 017 30024
    SUB s2, 01                      ; 018 1C201
    JUMP Z, L_01B                   ; 019 3501B
    JUMP L_00D                      ; 01A 3400D
L_01B:
    STORE s3, dna0                  ; 01B 2E30A  DNA -> dna0..dna7
    STORE s4, dna1                  ; 01C 2E40B
    STORE s5, dna2                  ; 01D 2E50C
    STORE s6, dna3                  ; 01E 2E60D
    STORE s7, dna4                  ; 01F 2E70E
    STORE s8, dna5                  ; 020 2E80F
    STORE s9, dna6                  ; 021 2E910
    STORE sA, dna7                  ; 022 2EA11
    JUMP dna_idle                   ; 023 34003

; ---- dna_clock ---- called from 008, 017
dna_clock:
    XOR s0, 01                      ; 024 0E001
    OUTPUT s0, DNA_CTRL             ; 025 2C0D3
    XOR s0, 01                      ; 026 0E001
    OUTPUT s0, DNA_CTRL             ; 027 2C0D3
    RETURN                          ; 028 2A000
; $029-$030: unreached words, kept as data
ADDRESS 029
    ; dead_dump_dna:
    ; 029: 00911  LOAD s9, 11               unreached: print the DNA on the debug port
    DATA_WORD 00911
    ; 02A: 07090  FETCH s0, (s9)
    DATA_WORD 07090
    ; 02B: 01E00  LOAD sE, s0
    DATA_WORD 01E00
    ; 02C: 30061  CALL dbg_putc
    DATA_WORD 30061
    ; 02D: 1490A  COMPARE s9, 0A
    DATA_WORD 1490A
    ; 02E: 2B000  RETURN Z
    DATA_WORD 2B000
    ; 02F: 1C901  SUB s9, 01
    DATA_WORD 1C901
    ; 030: 3402A  JUMP 02A
    DATA_WORD 3402A

; CRC-16, reflected poly $A001, init $FFFF, over s5 bytes at (s4).
; Result s7:s6.

; ---- crc16 ---- called from 18E
crc16:
    LOAD s7, FF                     ; 031 007FF
    LOAD s6, FF                     ; 032 006FF
L_033:
    FETCH s2, (s4)                  ; 033 07240
    LOAD s3, 00                     ; 034 00300
    XOR s6, s2                      ; 035 0F620
L_036:
    COMPARE s3, 08                  ; 036 14308
    JUMP Z, L_03F                   ; 037 3503F
    ADD s3, 01                      ; 038 18301
    SR0 s7                          ; 039 2070E
    SRA s6                          ; 03A 20608
    JUMP NC, L_036                  ; 03B 35C36
    XOR s7, A0                      ; 03C 0E7A0
    XOR s6, 01                      ; 03D 0E601
    JUMP L_036                      ; 03E 34036
L_03F:
    ADD s4, 01                      ; 03F 18401
    SUB s5, 01                      ; 040 1C501
    JUMP NZ, L_033                  ; 041 35433
    RETURN                          ; 042 2A000

; CRC-7 (poly x^7+x^3+1, the SD card CRC) over s4 bytes at (s0).
; Result -> want/compare via scratch $15.

; ---- crc7 ---- called from 1A7
crc7:
    LOAD sF, 00                     ; 043 00F00
L_044:
    LOAD s1, 08                     ; 044 00108
    FETCH s2, (s0)                  ; 045 07200
L_046:
    SL0 sF                          ; 046 20F06
    LOAD sE, sF                     ; 047 01EF0
    XOR sE, s2                      ; 048 0FE20
    RL sE                           ; 049 20E02
    AND sE, 01                      ; 04A 0AE01
    OR sF, sE                       ; 04B 0DFE0
    RL sE                           ; 04C 20E02
    RL sE                           ; 04D 20E02
    RL sE                           ; 04E 20E02
    XOR sE, sF                      ; 04F 0FEF0
    AND sE, 08                      ; 050 0AE08
    AND sF, F7                      ; 051 0AFF7
    OR sF, sE                       ; 052 0DFE0
    SL0 s2                          ; 053 20206
    SUB s1, 01                      ; 054 1C101
    JUMP NZ, L_046                  ; 055 35446
    ADD s0, 01                      ; 056 18001
    SUB s4, 01                      ; 057 1C401
    JUMP NZ, L_044                  ; 058 35444
    STORE sF, 15                    ; 059 2EF15
    RETURN                          ; 05A 2A000

; ---- verdict_a_ok ---- called from 194
verdict_a_ok:
    LOAD s0, F1                     ; 05B 000F1
    STORE s0, verdict_a             ; 05C 2E019
    RETURN                          ; 05D 2A000

; ---- verdict_b_ok ---- called from 1AA
verdict_b_ok:
