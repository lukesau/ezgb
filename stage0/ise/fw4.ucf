# FW4 constraints written by hand, appended to the generated top.ucf.

# Every pad is LVCMOS33, 4 mA, slow. LVTTL at 4 or 6 mA sets the same bits;
# found by building each standard and drive and comparing the IOB bits.
NET "P*" IOSTANDARD = LVCMOS33 | DRIVE = 4 | SLEW = SLOW;

# pull-ups: the SD card lines and the clock chip's I2C
NET "P25" PULLUP;
NET "P28" PULLUP;
NET "P29" PULLUP;
NET "P30" PULLUP;
NET "P31" PULLUP;
NET "P32" PULLUP;
NET "P34" PULLUP;

# the 24.545 MHz oscillator; the DCM's clocks follow from it
NET "P43" TNM_NET = "osc";
TIMESPEC "TS_osc" = PERIOD "osc" 40.74 ns HIGH 50%;

# The Game Boy's write clocks, /WR (P84) and /WR | A15 (wr_a15_n, clocks
# the $7Fxx registers). Asynchronous to the oscillator: crossings into and
# out of them go through synchronizers, so they get their own unrelated
# periods. 400 ns is under half a double-speed CGB cycle.
NET "P84" TNM_NET = "gb_wr";
TIMESPEC "TS_gb_wr" = PERIOD "gb_wr" 400 ns HIGH 50%;
NET "n_X17Y31_S0_Y" TNM_NET = "gb_wr_a15";
TIMESPEC "TS_gb_wr_a15" = PERIOD "gb_wr_a15" 400 ns HIGH 50%;

# The memory page (psram_ctrl page_d) samples the loader's and the SD
# filler's addresses, on the 2x clock, on every fx clock, and acts on a
# value only once two samples agree (page_d == page_q): the crossing is
# built to absorb a late bit, so the 2x-to-fx paths into it are not timed.
INST "u_logic/u_psram_ctrl/page_d_*" TNM = "psram_page_d";
TIMESPEC "TS_page_cdc" = FROM "n_X13Y1_DCM_CLK2X" TO "psram_page_d" TIG;

# the clock chip's I2C lines drive at 2 mA (their bits match LVCMOS33 2 mA)
NET "P31" DRIVE = 2;
NET "P32" DRIVE = 2;
