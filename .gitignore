.DS_Store

# Python bytecode
__pycache__/
*.py[cod]

# Game Boy ROMs, anywhere: EZ Flash's kernel, stage1 and updaters, our own
# builds of them, test ROMs. Only the disassemblies and sources are tracked.
*.gb
*.gbc
*.sgb

# EZ Flash's copyrighted firmware binaries, not our work, keep local-only.
# /ezgb.dat is kept as a guard: nothing reads a root-level kernel any more
# (use kernel/re/<version>/kernel.gb), but a stray dump dropped here must not be committed.
/ezgb.dat
kernel/re/*/kernel.gb.orig
# ...and anything else derived from it: probe builds, chain-boot copies,
# ezgb.dat drops. A modified kernel still contains EZ Flash's firmware.
kernel/re/*/*.dat
# updater disassembly build artifacts (the updaters' .gb files are covered above)
stage0/re/updater/*/disassembly/game.o
stage0/re/updater/*/disassembly/game.map
stage0/re/updater/*/disassembly/game.sym

# cloned reference tools (mgbdis, omega-de-kernel, SameBoy), not our code.
# Anchored: an unanchored `tools/` matches a directory of that name at ANY
# depth, and for as long as it existed it silently swallowed kernel/mod/tools/,
# this project's injection and verification tooling.
/tools/

# build artifacts from `make` inside the kernel and stage1 disassemblies
kernel/re/*/disassembly/game.o
kernel/re/*/disassembly/game.map
kernel/re/*/disassembly/game.sym
stage1/re/*/disassembly/game.o
stage1/re/*/disassembly/game.map
stage1/re/*/disassembly/game.sym

# Debugger auto-trace output
scripts/debug/*.log

# SameBoy run artifacts (battery save, screenshot, debug log) are regenerated
# locally, not source; the debug log also embeds your local filesystem path.
kernel/re/*/kernel.sav
kernel/re/*/kernel.bmp
kernel/re/*/kernel.log

# Cart config-flash dumps and repair images. Same policy as the firmware
# packages: these are EZ Flash's FPGA bitstream, not this project's work, so
# they stay local. See fpga/README.md.
/fpga/*
# The floorplan page has no block RAM contents and is tracked and published
# (scripts/publish-floorplan.sh); its intermediate files are not.
/stage0/floorplan/*.jsonl

*.bin

# Local microSD for the SameBoy EZ Jr FPGA stub: a local dev directory,
# nothing in it is tracked (card images, ROMs, saves, psram.bin, ORDER).
# The workflow is in docs/DEVELOPMENT.md.
/sd/

dist/

# machine-specific scripts that depend on private infrastructure (lukesau.com logs etc.)
/local/

# stock kernel build output (generated includes, the built stock kernel)
kernel/stock/build/
