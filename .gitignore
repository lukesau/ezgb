.DS_Store

# Python bytecode
__pycache__/
*.py[cod]

# EZ Flash's copyrighted firmware binaries, not our work, keep local-only
/ezgb.dat
/juniorkernel-1.04e-FW4/
/juniorkernel-1.05e-FW5/
re/*/kernel.gb
re/*/kernel.gb.orig
# ...and anything else derived from it: probe builds, chain-boot copies,
# ezgb.dat drops. A modified kernel still contains EZ Flash's firmware.
re/*/*.gb
re/*/*.gbc
re/*/*.dat

# cloned reference tools (mgbdis, omega-de-kernel, SameBoy), not our code.
# Anchored: an unanchored `tools/` matches a directory of that name at ANY
# depth, which silently swallowed decomp/tools/ — this project's own injection
# and verification tooling — for as long as it existed.
/tools/

# build artifacts from `make` inside re/*/disassembly
re/*/disassembly/game.gb
re/*/disassembly/game_trunc.gb
re/*/disassembly/game.o
re/*/disassembly/game.map
re/*/disassembly/game.sym

# Debugger auto-trace output
scripts/debug/*.log

# SameBoy run artifacts (battery save, screenshot, debug log) — regenerated
# locally, not source; the debug log also embeds your local filesystem path.
re/*/kernel.sav
re/*/kernel.bmp
re/*/kernel.log

# Ephemeral propose-labels / packet output
re/*/label-proposals.txt

# Cart config-flash dumps and repair images. Same policy as the firmware
# packages: these are EZ Flash's FPGA bitstream, not this project's work, so
# they stay local. See fpga/README.md.
/fpga/**
!/fpga/README.md
*.bin
!sd/fram.bin

# Local microSD for the SameBoy EZ Jr FPGA stub.
# ROMs, saves, and raw card images are copyrighted / personal — stay out of git.
/sd/**
!/sd/README.md

